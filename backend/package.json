{
  "name": "laprizza-backend",
  "version": "0.1.0",
  "description": "LaPrizza back-end application (Sprint 1 skeleton)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "test:flows": "httpyac send --all -o short \"test-flows/**/*.http\"",
    "test:all": "npm test && npm run test:flows",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "httpyac": "^6.16.7",
    "prettier": "^3.9.9"
  },
  "directories": {
    "test": "test"
  },
  "keywords": []
}
