@employeePassword = Ai01Employee123!

@massa = de01b0000000000000000001
@molho = de01b0000000000000000002
@mozzarella = de01b0000000000000000003
@fiambre = de01b0000000000000000004
@cogumelos = de01b0000000000000000005
@basePronta = de01b0000000000000000006
@oregaos = de01b0000000000000000007
