### ============================================================
### BCK10 - Predefined Pizza Management (REST Client)
### ============================================================

@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!

# O Employee é criado no pedido 1.2 (o seeder só cria o Manager)
@employeePassword = StrongPassword123!


### ==========================================
### 1: AUTENTICAÇÃO E PREPARAÇÃO DOS DADOS
### ==========================================

### 1.1 Login do Manager (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.token}}

### 1.2 POST Criar Employee (201 Created)
# O email é aleatório para o flow poder correr mais do que uma vez.
# @name createEmployee
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "emp{{$randomInt 100000 999999}}@laprizza.pt",
  "password": "{{employeePassword}}",
  "role": "EMPLOYEE"
}

?? status == 201

### Variáveis
@employeeEmail = {{createEmployee.email}}

### 1.3 Login do Employee
# @name loginEmployee
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{employeeEmail}}",
  "password": "{{employeePassword}}"
}

?? status == 200

### Extração do Token do Employee
@employeeToken = {{loginEmployee.token}}

# Os pedidos 1.4 a 1.29 criam todos os dados de que a pizza precisa, com nomes únicos por execução.
# Os tipos de componente (Base Dough, Base Sauce, Cheese e Topping) vêm do seeder e são só consultados.

### 1.4 POST Categoria dos produtos (201 Created)
# O nome é um número aleatório. É reutilizado (@runId) para tornar únicos os nomes dos pedidos seguintes.
# @name createCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{$randomInt 100000 999999}}"
}

?? status == 201

### Variáveis
@runId = {{createCategory.name}}
@categoryId = {{createCategory.id}}

### 1.5 GET Listar os tipos de componente (200 OK - só para consulta)
# Se a pizza falhar com 'Pizza Component Type "X" requires at least N', o tipo X tem mínimo maior que 0
# e não vem do seeder (sobra de outros testes): corrigir esse tipo ou removê-lo.
GET {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}

?? status == 200

### 1.6 GET Tipo Base Dough (200 OK)
# @name getTypeDough
GET {{baseUrl}}/pizza-component-type?name=Base%20Dough
Authorization: Bearer {{adminToken}}

?? status == 200

### Variáveis
@doughTypeId = {{getTypeDough[0].id}}

### 1.7 GET Tipo Base Sauce (200 OK)
# @name getTypeSauce
GET {{baseUrl}}/pizza-component-type?name=Base%20Sauce
Authorization: Bearer {{adminToken}}

?? status == 200

### Variáveis
@sauceTypeId = {{getTypeSauce[0].id}}

### 1.8 GET Tipo Cheese (200 OK)
# @name getTypeCheese
GET {{baseUrl}}/pizza-component-type?name=Cheese
Authorization: Bearer {{adminToken}}

?? status == 200

### Variáveis
@cheeseTypeId = {{getTypeCheese[0].id}}

### 1.9 GET Tipo Topping (200 OK)
# @name getTypeTopping
GET {{baseUrl}}/pizza-component-type?name=Topping
Authorization: Bearer {{adminToken}}

?? status == 200

### Variáveis
@toppingTypeId = {{getTypeTopping[0].id}}

### 1.10 POST Tamanho pequeno (201 Created)
# @name createSizeSmall
POST {{baseUrl}}/pizza-size
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pequena {{runId}}"
}

?? status == 201

### Variáveis
@sizeSmall = {{createSizeSmall.id}}

### 1.11 POST Tamanho grande (201 Created)
# @name createSizeLarge
POST {{baseUrl}}/pizza-size
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Grande {{runId}}"
}

?? status == 201

### Variáveis
@sizeLarge = {{createSizeLarge.id}}

### 1.12 POST Produto da pizza: vendável e sem tipo de componente (201 Created)
# O nome não tem espaços para poder ir no URL das pesquisas por nome.
# @name createPizzaProduct
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Margherita{{runId}}",
  "description": "Pizza predefinida de teste",
  "price": 10,
  "sellable": true,
  "stockControlled": false,
  "categoryId": "{{categoryId}}"
}

?? status == 201

### Variáveis
@pizzaProductId = {{createPizzaProduct.id}}
@pizzaProductName = {{createPizzaProduct.name}}

