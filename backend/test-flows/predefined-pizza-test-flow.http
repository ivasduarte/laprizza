### ==========================================
### 2: CRIAÇÃO E VALIDAÇÕES (POST)
### ==========================================

### 2. POST Criar pizza predefinida válida (201 Created)
# @name createPizza
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": [
    "{{sizeSmall}}",
    "{{sizeLarge}}"
  ],
  "componentIds": [
    "{{dough}}",
    "{{sauce}}",
    "{{cheese}}"
  ]
}

?? status == 201

### Variáveis
@pizzaId = {{createPizza.id}}

### 2.1 POST Segunda pizza para o mesmo produto (409 Conflict)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}"]
}

?? status == 409

### 2.2 POST Sem productId - Joi (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}"]
}

?? status == 400

### 2.3 POST Com id inválido (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "abc",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}"]
}

?? status == 400

### 2.4 POST Com lista de tamanhos vazia - Joi (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": [],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}"]
}

?? status == 400

### 2.5 POST Com componente repetido (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}", "{{cheese}}"]
}

?? status == 400

### 2.6 POST Com componente inativo (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{inactiveComponent}}"]
}

?? status == 400

### 2.7 POST Sem massa, tipo Base Dough com minQuantity 1 (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{sauce}}", "{{cheese}}"]
}

?? status == 400

### 2.8 POST Acima do maxQuantity, dois queijos (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheeseExtra1}}", "{{cheeseExtra2}}"]
}

?? status == 400

### 2.9 POST Com tamanho sem ComponentSizeConfiguration (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{pizzaProductId}}",
  "sizeIds": ["{{sizeLarge}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{noLargeConfig}}"]
}

?? status == 400

### 2.10 POST Com produto componente a representar a pizza (400 Bad Request)
POST {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{dough}}",
  "sizeIds": ["{{sizeSmall}}"],
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheese}}"]
}

?? status == 400


### ==========================================
### 3: PESQUISA E CONSULTAS (GET)
### ==========================================

### 3. GET Listar Todas como Manager (200 OK)
GET {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.1 GET Listar Todas como Employee (200 OK)
GET {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{employeeToken}}

?? status == 200

### 3.2 GET Pesquisa por nome do produto, como Employee (200 OK - devolve a pizza criada)
GET {{baseUrl}}/predefined-pizzas?name={{pizzaProductName}}
Authorization: Bearer {{employeeToken}}

?? status == 200

### 3.3 GET Pesquisa sem resultados (200 OK - devolve [])
GET {{baseUrl}}/predefined-pizzas?name=nao-existe-xyz
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.4 GET Nome vazio - Joi (400 Bad Request)
GET {{baseUrl}}/predefined-pizzas?name=
Authorization: Bearer {{adminToken}}

?? status == 400

### 4. GET Por ID, como Employee (200 OK)
GET {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{employeeToken}}

?? status == 200

### 4.1 GET ID com formato inválido (400 Bad Request)
GET {{baseUrl}}/predefined-pizzas/abc
Authorization: Bearer {{adminToken}}

?? status == 400

### 4.2 GET ID válido mas inexistente (404 Not Found)
GET {{baseUrl}}/predefined-pizzas/000000000000000000000000
Authorization: Bearer {{adminToken}}

?? status == 404

### 4.3 GET Por nome exato, como Employee (200 OK)
GET {{baseUrl}}/predefined-pizzas/name/{{pizzaProductName}}
Authorization: Bearer {{employeeToken}}

?? status == 200

### 4.4 GET Por nome inexistente (404 Not Found)
GET {{baseUrl}}/predefined-pizzas/name/NaoExiste
Authorization: Bearer {{adminToken}}

?? status == 404


### ==========================================
### 4: ATUALIZAÇÃO E DESATIVAÇÃO (PUT)
### ==========================================

### 5. PUT Atualizar componentes (200 OK)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "componentIds": ["{{dough}}", "{{sauce}}", "{{cheeseExtra1}}"]
}

?? status == 200

### 5.1 PUT Atualizar tamanhos (200 OK)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sizeIds": ["{{sizeSmall}}"]
}

?? status == 200

### 5.2 PUT Atualizar com configuração inválida (400 Bad Request)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "componentIds": ["{{dough}}", "{{sauce}}", "{{inactiveComponent}}"]
}

?? status == 400

### 5.3 PUT Body vazio - Joi (400 Bad Request)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

?? status == 400

### 5.4 PUT isActive: true - Joi (400 Bad Request)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": true
}

?? status == 400

### 5.5 PUT Desativar pizza (200 OK)
PUT {{baseUrl}}/predefined-pizzas/{{pizzaId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

?? status == 200


