@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicEmail = cliente_{{$timestamp}}@laprizza.pt

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Admin (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.accessToken}}


### ==========================================
### 2: CRIAÇÃO E VALIDAÇÕES DO CLIENTE
### ==========================================

### 2. POST Cliente Novo com Restrições (201 Created)
# @name createCustomer
POST {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Maria Santos",
  "email": "{{dynamicEmail}}",
  "phoneNumber": "91{{$randomInt 1000000 9999999}}",
  "address": {
    "street": "Rua Principal",
    "houseNumber": "10",
    "postalCode": "4460-123",
    "city": "Senhora da Hora",
    "district": "Porto"
  },
  "dietaryRestrictions": ["65231abcd345678901234567"]
}

?? status == 201

### Variáveis
@customerId = {{createCustomer.id}}
@createdEmail = {{createCustomer.email}}
@createdPhone = {{createCustomer.phoneNumber}}

### 2.1 POST Email Duplicado (409 Conflict)
POST {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Outro Cliente",
  "email": "{{createdEmail}}",
  "phoneNumber": "929999999",
  "address": {
    "street": "Rua B",
    "houseNumber": "1",
    "postalCode": "4000-000",
    "city": "Porto",
    "district": "Porto"
  }
}

?? status == 409

### 2.2 POST Alergénios Duplicados no Array - Joi (400 Bad Request)
POST {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Teste Duplicados",
  "email": "duplicados_{{$timestamp}}@laprizza.pt",
  "phoneNumber": "912345678",
  "address": {
    "street": "Rua B",
    "houseNumber": "1",
    "postalCode": "4000-000",
    "city": "Porto",
    "district": "Porto"
  },
  "dietaryRestrictions": [
    "65231abcd345678901234567",
    "65231abcd345678901234567"
  ]
}

?? status == 400


### 2.3 POST Telefone já usado, noutro formato (409 Conflict)
POST {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Telefone Repetido",
  "email": "telefone_{{$timestamp}}@laprizza.pt",
  "phoneNumber": "+351 {{createdPhone}}",
  "address": {
    "street": "Rua B",
    "houseNumber": "1",
    "postalCode": "4000-000",
    "city": "Porto",
    "district": "Porto"
  }
}

?? status == 409

### ==========================================
### 3: PESQUISA E CONSULTAS
### ==========================================

### 3. GET Listar Todos (200 OK)
GET {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.1 GET Pesquisa por Nome (200 OK)
GET {{baseUrl}}/customers?search=Maria
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.2 GET Pesquisa por Email (200 OK)
GET {{baseUrl}}/customers?search={{createdEmail}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 4. GET Por ID (200 OK)
GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}

?? status == 200


### ==========================================
### 4: ATUALIZAÇÃO E VALIDAÇÕES DO PATCH
### ==========================================

### 5. PATCH Telefone Inválido (400 Bad Request - Proteção de Domínio no Update)
PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "phoneNumber": "telefone_invalido"
}

?? status == 400

### 5.1 POST Segundo Cliente (necessário para provar o conflito de email no PATCH)
# @name createSecondCustomer
POST {{baseUrl}}/customers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Segundo Cliente",
  "email": "segundo_{{$timestamp}}@laprizza.pt",
  "phoneNumber": "92{{$randomInt 1000000 9999999}}",
  "address": {
    "street": "Rua C",
    "houseNumber": "2",
    "postalCode": "4000-000",
    "city": "Porto",
    "district": "Porto"
  }
}

?? status == 201

### Variáveis
@secondEmail = {{createSecondCustomer.email}}
@secondPhone = {{createSecondCustomer.phoneNumber}}

### 5.2 PATCH Email de outro cliente (409 Conflict)
PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{secondEmail}}"
}

?? status == 409


### 5.2.1 PATCH Telefone de outro cliente, noutro formato (409 Conflict)
PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "phoneNumber": "+351 {{secondPhone}}"
}

?? status == 409

### 5.3 PATCH Alergénios Duplicados - Joi (400 Bad Request)
PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "dietaryRestrictions": [
    "65231abcd345678901234567",
    "65231abcd345678901234567"
  ]
}

?? status == 400

### 5.4 PATCH Válido - Atualizar Dados e Inativar (200 OK)
PATCH {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "phoneNumber": "93{{$randomInt 1000000 9999999}}",
  "isActive": false
}

?? status == 200