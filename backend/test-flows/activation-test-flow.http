@baseUrl = http://localhost:3000/api/v2
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
# AA07: o token do convite só existe no email. Este fluxo lê-o da API do Mailpit
# (docker compose up mailpit; web UI e API em http://localhost:8025).
@mailpitUrl = http://localhost:8025
@newPassword = LaPrizzaAtiv_013DI!
@localEmail = aa07_{{$timestamp}}@laprizza.pt
@replacedEmail = aa07_rep_{{$timestamp}}@laprizza.pt

### ==========================================
### 1: PREPARAÇÃO (AA06 cria a conta inativa e envia o convite)
### ==========================================

### 1.1 Login do Admin (Seeder)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200

### Extração do token do Admin
@token = {{login.accessToken}}

### 1.2 POST Conta nova com EMPLOYEE (201 Created - inativa, convite enviado para o Mailpit)
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{localEmail}}",
  "roles": ["EMPLOYEE"]
}

?? status == 201
?? js response.parsedBody.status == inactive
?? js response.parsedBody.pendingActivation == true
?? js response.parsedBody.invitation.sent == true

### Extração do estado
@userId = {{createUser.id}}

### 1.3 Procurar o email do convite no Mailpit (200 OK - o mais recente vem primeiro)
# @name inviteSearch
GET {{mailpitUrl}}/api/v1/search?query=to:{{localEmail}}

?? status == 200
?? js response.parsedBody.messages.length >= 1

### 1.4 Ler o email do convite (200 OK - tem o link, nunca uma password)
# @name inviteMail
GET {{mailpitUrl}}/api/v1/message/{{inviteSearch.messages[0].ID}}

?? status == 200
?? js response.parsedBody.Text.includes('/activate#token=') == true
?? js response.parsedBody.Text.toLowerCase().includes('password:') == false

### Extração do token do link (valor depois de "#token=")
@activationToken = {{inviteMail.Text.match(/#token=([A-Za-z0-9_-]{43})/)[1]}}


### ==========================================
### 2: VERIFICAR O LINK (POST /auth/activation/inspect)
### ==========================================

### 2.1 Token com formato inválido (400 Bad Request - VALIDATION_FAILED, o valor não é ecoado)
POST {{baseUrl}}/auth/activation/inspect
Content-Type: application/json

{
  "token": "nao-e-um-token"
}

?? status == 400
?? js response.parsedBody.error.code == VALIDATION_FAILED

### 2.2 Token bem formado mas desconhecido (400 Bad Request - INVITATION_INVALID)
POST {{baseUrl}}/auth/activation/inspect
Content-Type: application/json

{
  "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
}

?? status == 400
?? js response.parsedBody.error.code == INVITATION_INVALID

### 2.3 Token do convite (200 OK - ativação local, email mascarado, nada é gasto)
POST {{baseUrl}}/auth/activation/inspect
Content-Type: application/json

{
  "token": "{{activationToken}}"
}

?? status == 200
?? header cache-control == no-store
?? js response.parsedBody.method == local
?? js response.parsedBody.email.startsWith('a***') == true
?? js response.parsedBody.expiresAt exists


### ==========================================
### 3: ATIVAÇÃO LOCAL (POST /auth/activation/local)
### ==========================================

### 3.1 Login antes da ativação (401 Unauthorized - a conta ainda não tem password nem está ativa)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{localEmail}}",
  "password": "{{newPassword}}"
}

?? status == 401

### 3.2 Password fraca (400 Bad Request - PASSWORD_POLICY_VIOLATION, o link não é gasto)
POST {{baseUrl}}/auth/activation/local
Content-Type: application/json

{
  "token": "{{activationToken}}",
  "newPassword": "fraca"
}

?? status == 400
?? js response.parsedBody.error.code == PASSWORD_POLICY_VIOLATION

### 3.3 Ativação com a password escolhida pelo utilizador (204 No Content - sem sessão nem cookie)
POST {{baseUrl}}/auth/activation/local
Content-Type: application/json

{
  "token": "{{activationToken}}",
  "newPassword": "{{newPassword}}"
}

?? status == 204
?? js Boolean(response.headers['set-cookie']) == false

### 3.4 Reutilizar o mesmo link (400 Bad Request - INVITATION_INVALID, uso único)
POST {{baseUrl}}/auth/activation/local
Content-Type: application/json

{
  "token": "{{activationToken}}",
  "newPassword": "{{newPassword}}"
}

?? status == 400
?? js response.parsedBody.error.code == INVITATION_INVALID

### 3.5 Login normal depois da ativação (200 OK - só as roles atribuídas pela AA06)
# @name userLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{localEmail}}",
  "password": "{{newPassword}}"
}

?? status == 200
?? js response.parsedBody.user.status == active
?? js response.parsedBody.user.roles.includes('EMPLOYEE') == true
?? js response.parsedBody.user.roles.includes('CUSTOMER') == true
?? js response.parsedBody.user.roles.includes('ADMINISTRATOR') == false
?? js response.parsedBody.user.roles.includes('MANAGER') == false

### 3.6 Estado visto pelo Admin (200 OK - ativa, já não espera ativação)
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.status == active
?? js response.parsedBody.pendingActivation == false

### 3.7 Novo convite para uma conta já ativa (409 Conflict - ACCOUNT_ALREADY_ACTIVATED)
POST {{baseUrl}}/users/{{userId}}/invitation
Authorization: Bearer {{token}}

?? status == 409
?? js response.parsedBody.error.code == ACCOUNT_ALREADY_ACTIVATED


### ==========================================
### 4: CONVITE SUBSTITUÍDO (o link antigo deixa de funcionar)
### ==========================================

### 4.1 POST Outra conta nova (201 Created)
# @name createReplaced
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{replacedEmail}}"
}

?? status == 201

### Extração do id
@replacedId = {{createReplaced.id}}

### 4.2 Email do primeiro convite (200 OK)
# @name firstSearch
GET {{mailpitUrl}}/api/v1/search?query=to:{{replacedEmail}}

?? status == 200

### 4.3 Ler o primeiro convite (200 OK)
# @name firstMail
GET {{mailpitUrl}}/api/v1/message/{{firstSearch.messages[0].ID}}

?? status == 200

### Extração do token antigo
@oldToken = {{firstMail.Text.match(/#token=([A-Za-z0-9_-]{43})/)[1]}}

### 4.4 O Admin emite um novo convite (201 Created - o anterior é revogado)
POST {{baseUrl}}/users/{{replacedId}}/invitation
Authorization: Bearer {{token}}

?? status == 201

### 4.5 Email do novo convite (200 OK - o mais recente vem primeiro)
# @name secondSearch
GET {{mailpitUrl}}/api/v1/search?query=to:{{replacedEmail}}

?? status == 200
?? js response.parsedBody.messages.length >= 2

### 4.6 Ler o novo convite (200 OK)
# @name secondMail
GET {{mailpitUrl}}/api/v1/message/{{secondSearch.messages[0].ID}}

?? status == 200

### Extração do token novo
@newToken = {{secondMail.Text.match(/#token=([A-Za-z0-9_-]{43})/)[1]}}

### 4.7 Ativar com o link antigo (400 Bad Request - INVITATION_INVALID, foi substituído)
POST {{baseUrl}}/auth/activation/local
Content-Type: application/json

{
  "token": "{{oldToken}}",
  "newPassword": "{{newPassword}}"
}

?? status == 400
?? js response.parsedBody.error.code == INVITATION_INVALID

### 4.8 Ativar com o link novo (204 No Content)
POST {{baseUrl}}/auth/activation/local
Content-Type: application/json

{
  "token": "{{newToken}}",
  "newPassword": "{{newPassword}}"
}

?? status == 204
