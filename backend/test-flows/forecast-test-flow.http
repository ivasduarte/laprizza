@baseUrl = http://localhost:3000/api/v2
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicName = Forecast_{{$timestamp}}
@missingId = 507f1f77bcf86cd799439011

# WEB07 - Forecasts imutáveis e versionados:
# - guardar um nome que já existe cria a versão seguinte (v1, v2, ...); a "version" enviada é ignorada;
# - o PUT só desativa ({ "isActive": false }): é o "apagar" do SPA;
# - regras de negócio (400, error.details[].type): productUnknown, sizeRequired, sizeIncompatible,
#   dateInvalid, dateOutside, periodInvalid, duplicate, noEntries;
# - entradas omitidas (data/produto/tamanho) significam consumo zero.
# Pré-requisito: o seed tem pelo menos uma pizza pré-definida ativa com tamanhos.

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Manager (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}
?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.accessToken}}

### ==========================================
### 2: DADOS DE SUPORTE
### ==========================================

### 2. GET Pizzas pré-definidas do seed (200 OK, pelo menos uma)
# @name listPizzas
GET {{baseUrl}}/predefined-pizzas
Authorization: Bearer {{adminToken}}
?? status == 200
?? js response.parsedBody.length > 0 == true

### Variáveis (pizza vendável e um tamanho aplicável a essa pizza)
@pizzaId = {{listPizzas[0].productId}}
@pizzaSizeId = {{listPizzas[0].sizeIds[0]}}

### 2.1 POST Categoria de suporte (201 Created)
# @name createCategoryRef
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria Forecast {{$timestamp}}"
}
?? status == 201

### Variáveis
@categoryId = {{createCategoryRef.id}}

### 2.2 POST Produto vendável sem tamanhos, ex.: bebida (201 Created)
# @name createDrinkRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Bebida Forecast {{$timestamp}}",
  "description": "Produto vendável sem tamanhos (sizeId null)",
  "sellable": true,
  "price": 1.5,
  "stockControlled": false,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@drinkId = {{createDrinkRef.id}}

### 2.3 POST Produto não vendável (201 Created)
# @name createRawRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Materia Prima Forecast {{$timestamp}}",
  "description": "Não vendável: não pode entrar num forecast",
  "sellable": false,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@rawId = {{createRawRef.id}}

### ==========================================
### 3: CRIAÇÃO E VERSÕES (POST)
### ==========================================

### 3. POST Forecast A - pizza com consumo variável em 2 dias + bebida; nome com espaços (201, v1)
# @name createForecast
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "   {{dynamicName}}   ",
  "startDate": "2026-11-23",
  "endDate": "2026-11-29",
  "entries": [
    { "date": "2026-11-23", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 20 },
    { "date": "2026-11-24", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 35 },
    { "date": "2026-11-24", "productId": "{{drinkId}}", "sizeId": null, "quantity": 10 },
    { "date": "2026-11-25", "productId": "{{drinkId}}", "quantity": 0 }
  ]
}
?? status == 201
?? js response.parsedBody.name === response.parsedBody.name.trim() == true
?? js response.parsedBody.version == 1
?? js response.parsedBody.isActive == true

### Variáveis
@forecastId = {{createForecast.id}}
@createdName = {{createForecast.name}}

### 3.1 POST Mesmo nome - cria a versão seguinte, a v1 mantém-se (201, v2)
# @name createForecastV2
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "startDate": "2026-11-23",
  "endDate": "2026-11-29",
  "entries": [
    { "date": "2026-11-23", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 25 },
    { "date": "2026-11-24", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 30 }
  ]
}
?? status == 201
?? js response.parsedBody.version == 2
?? js response.parsedBody.id !== forecastId == true

### 3.2 POST Mesmo nome em MAIÚSCULAS - a versão ignora maiúsculas/minúsculas (201, v3)
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName.toUpperCase()}}",
  "startDate": "2026-11-23",
  "endDate": "2026-11-29",
  "entries": [
    { "date": "2026-11-23", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 5 }
  ]
}
?? status == 201
?? js response.parsedBody.version == 3

### 3.3 POST version enviada é ignorada - o back end atribui a seguinte (201, v4)
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "version": 99,
  "startDate": "2026-11-23",
  "endDate": "2026-11-29",
  "entries": [
    { "date": "2026-11-23", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 5 }
  ]
}
?? status == 201
?? js response.parsedBody.version == 4

### 3.4 GET A v1 continua igual depois das novas versões (200 OK)
GET {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
?? status == 200
?? js response.parsedBody.version == 1
?? js response.parsedBody.entries.length == 4

### 3.5 POST Forecast B - outro forecast com consumo de pizza variável em 2 dias (201, v1)
# @name createForecastB
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Forecast_B_{{$timestamp}}",
  "startDate": "2026-11-23",
  "endDate": "2026-11-29",
  "entries": [
    { "date": "2026-11-23", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 8 },
    { "date": "2026-11-25", "productId": "{{pizzaId}}", "sizeId": "{{pizzaSizeId}}", "quantity": 40 }
  ]
}
?? status == 201
?? js response.parsedBody.version == 1

### Variáveis
@forecastBId = {{createForecastB.id}}

