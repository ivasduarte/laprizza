### 3.20 POST Data que não é uma data válida (400 Bad Request)
# O Joi só valida que é string; quem rejeita é o Mongoose (cast para Date).
# Se este pedido devolver 500, falta mapear o erro de cast para 400.
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Data_Invalida_{{$timestamp}}",
  "startDate": "isto-nao-e-uma-data",
  "endDate": "2026-11-30",
  "entries": []
}
?? status == 400

### 3.21 POST Segundo Forecast, com campos extra ignorados (201 Created, isActive = true)
# @name createSecondForecast
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Forecast_Extra_{{$randomInt 1000 9999}}",
  "startDate": "2026-12-01",
  "endDate": "2026-12-31",
  "entries": [],
  "isActive": false,
  "role": "MANAGER"
}
?? status == 201

### Variáveis
@secondId = {{createSecondForecast.id}}
@secondName = {{createSecondForecast.name}}


### ==========================================
### 4: PESQUISA E CONSULTAS (GET)
### ==========================================

### 4. GET Listar Todos (200 OK)
GET {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
?? status == 200

### 4.1 GET Pesquisa parcial por nome (200 OK)
GET {{baseUrl}}/forecasts?name=Forecast
Authorization: Bearer {{adminToken}}
?? status == 200

### 4.2 GET Pesquisa sem resultados (200 OK, [])
GET {{baseUrl}}/forecasts?name=zzz_inexistente
Authorization: Bearer {{adminToken}}
?? status == 200

### 4.3 GET Pesquisa com caracteres de regex tratados como texto (200 OK, [])
GET {{baseUrl}}/forecasts?name=.*
Authorization: Bearer {{adminToken}}
?? status == 200

### 4.4 GET name vazio - Joi (400 Bad Request)
GET {{baseUrl}}/forecasts?name=
Authorization: Bearer {{adminToken}}
?? status == 400

### 4.5 GET name enviado duas vezes - Joi (400 Bad Request)
GET {{baseUrl}}/forecasts?name=a&name=b
Authorization: Bearer {{adminToken}}
?? status == 400

### 4.6 GET Por ID (200 OK, com as 2 entradas)
GET {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
?? status == 200

### 4.7 GET Por ID com formato inválido (400 Bad Request)
GET {{baseUrl}}/forecasts/abc123
Authorization: Bearer {{adminToken}}
?? status == 400

### 4.8 GET Por ID inexistente (404 Not Found)
GET {{baseUrl}}/forecasts/{{missingId}}
Authorization: Bearer {{adminToken}}
?? status == 404


### ==========================================
### 5: DESATIVAR (PUT com isActive:false)
### ==========================================
# O PUT só aceita { "isActive": false } - não renomeia nem altera entradas.

### 5. PUT Body vazio - Joi (400 Bad Request)
PUT {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}
?? status == 400

### 5.1 PUT Só com name - Joi (400 Bad Request - não é possível renomear)
PUT {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Outro_Nome"
}
?? status == 400

### 5.2 PUT isActive:true - Joi (400 Bad Request)
PUT {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": true
}
?? status == 400

### 5.3 PUT isActive inválido - Joi (400 Bad Request)
PUT {{baseUrl}}/forecasts/{{forecastId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": "abc"
}
?? status == 400

### 5.4 PUT ID com formato inválido (400 Bad Request)
PUT {{baseUrl}}/forecasts/abc
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}
?? status == 400

### 5.5 PUT ID inexistente (404 Not Found)
PUT {{baseUrl}}/forecasts/{{missingId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}
?? status == 404

### 5.6 PUT Desativar forecast (200 OK, isActive = false; o name enviado é ignorado)
PUT {{baseUrl}}/forecasts/{{secondId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Nome_Ignorado",
  "isActive": false
}
?? status == 200


### ==========================================
### 6: CONSISTÊNCIA APÓS DESATIVAR
### ==========================================

### 6. GET Por ID do desativado (404 Not Found)
GET {{baseUrl}}/forecasts/{{secondId}}
Authorization: Bearer {{adminToken}}
?? status == 404

### 6.1 GET Listar - o desativado já não aparece (200 OK)
GET {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
?? status == 200

### 6.2 GET Pesquisa por nome - o desativado já não aparece (200 OK, [])
GET {{baseUrl}}/forecasts?name={{secondName}}
Authorization: Bearer {{adminToken}}
?? status == 200

### 6.3 PUT Desativar outra vez (404 Not Found)
PUT {{baseUrl}}/forecasts/{{secondId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}
?? status == 404

### 6.4 POST Mesmo nome do desativado (409 Conflict - o nome continua reservado)
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{secondName}}",
  "startDate": "2026-12-01",
  "endDate": "2026-12-31",
  "entries": []
}
?? status == 409


