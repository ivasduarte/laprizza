@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicName = Forecast_{{$timestamp}}
@missingId = 507f1f77bcf86cd799439011

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Manager (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}
?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.accessToken}}

### ==========================================
### 2: DADOS DE SUPORTE (produto usado nas entradas)
### ==========================================

### 2. POST Categoria de suporte (201 Created)
# @name createCategoryRef
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria Forecast {{$timestamp}}"
}
?? status == 201

### Variáveis
@categoryId = {{createCategoryRef.id}}

### 2.1 POST Produto de suporte (201 Created)
# @name createProductRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Produto Forecast {{$timestamp}}",
  "description": "Produto para entradas de forecast",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@productId = {{createProductRef.id}}

### ==========================================
### 3: CRIAÇÃO E VALIDAÇÕES (POST)
### ==========================================

### 3. POST Forecast Novo - com espaços à volta para provar o trim (201 Created)
# @name createForecast
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "   {{dynamicName}}   ",
  "startDate": "2026-11-01",
  "endDate": "2026-11-30",
  "entries": [
    {
      "date": "2026-11-01",
      "productId": "{{productId}}",
      "sizeId": null,
      "quantity": 10
    },
    {
      "date": "2026-11-02",
      "productId": "{{productId}}",
      "quantity": 0
    }
  ]
}
?? status == 201

### Variáveis
@forecastId = {{createForecast.id}}
@createdName = {{createForecast.name}}

### 3.1 POST Nome Duplicado (mesma versão) (409 Conflict)
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "startDate": "2026-11-01",
  "endDate": "2026-11-30",
  "entries": []
}
?? status == 409

### 3.2 POST Nome Duplicado com outras maiúsculas (409 Conflict)
# Altera manualmente o nome abaixo para MAIÚSCULAS (ex.: FORECAST_1760000000)
# para validar que a unicidade ignora maiúsculas/minúsculas.
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "startDate": "2026-11-01",
  "endDate": "2026-11-30",
  "entries": []
}
?? status == 409

### 3.3 POST Mesmo nome com outra versão (201 Created - versões diferentes são permitidas)
POST {{baseUrl}}/forecasts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "version": 2,
  "startDate": "2026-11-01",
  "endDate": "2026-11-30",
  "entries": []
}
?? status == 201

