@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicName = Produto_{{$timestamp}}
@missingId = 507f1f77bcf86cd799439011

### ==========================================
### 1: AUTENTICAÇÃO E SETUP DE DEPENDÊNCIAS
### ==========================================

### 1.1 Login do Admin (Manager)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.token}}


### 1.2 Criar Categoria de Referência
# @name createCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria {{$timestamp}}"
}

?? status == 201

### Guarda Categoria
@categoryId = {{createCategory.id}}


### 1.3 Criar Alergénio de Referência
# @name createAllergen
POST {{baseUrl}}/allergens
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Alergenio {{$timestamp}}"
}

?? status == 201

### Guarda Alergenio
@allergenId = {{createAllergen.id}}


### 1.4 Criar Tipo de Componente de Referência
# @name createComponentType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Tipo {{$timestamp}}",
  "assemblyOrder": {{$randomInt 10000 99999}},
  "minQuantity": 0,
  "maxQuantity": 1
}

?? status == 201

### Guarda Tipo de Componente
@typeId = {{createComponentType.id}}


### ==========================================
### 2: CRIAÇÃO E VALIDAÇÕES DO PRODUTO (POST)
### ==========================================

### 2.1 POST Produto Válido Completo (201 Created)
# @name createProduct
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Massa Fina com Glúten {{$timestamp}}",
  "description": "Massa base para pizzas rica em glúten",
  "price": 0,
  "sellable": false,
  "stockControlled": true,
  "categoryId": "{{categoryId}}",
  "pizzaComponentTypeId": "{{typeId}}",
  "allergenIds": [
    "{{allergenId}}"
  ]
}

?? status == 201

### Variáveis do Produto
@productId = {{createProduct.id}}

### 2.2 POST Produto Simples Vendável (201 Created)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Coca-Cola 33cl {{$timestamp}}",
  "description": "Refrigerante lata",
  "price": 1.50,
  "sellable": true,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}

?? status == 201

### 2.3 Regra de Negócio: Vendável mas sem preço válido (400 Bad Request)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Água Mineral {{$timestamp}}",
  "description": "Garrafa de água",
  "price": -1.0,
  "sellable": true,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}

?? status == 400

### 2.4 Integridade Referencial: Categoria Inexistente (404 Not Found)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Produto Sem Categoria {{$timestamp}}",
  "description": "Falha na referência",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{missingId}}"
}

?? status == 404

### 2.5 Falha Joi: Nome vazio e falta de campos obrigatórios (400 Bad Request)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}

?? status == 400

### 2.6 Falha Joi: ID de Categoria em formato inválido (400 Bad Request)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Produto Joi Falha {{$timestamp}}",
  "description": "Teste ID",
  "sellable": false,
  "stockControlled": true,
  "categoryId": "123_formato_errado"
}

?? status == 400

### 2.7 Integridade Referencial: Tipo de Componente Inexistente (404 Not Found)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Falha Componente {{$timestamp}}",
  "description": "ID com formato válido mas inexistente",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}",
  "pizzaComponentTypeId": "{{missingId}}"
}

?? status == 404

### 2.8 Integridade Referencial: Alergénio Inexistente (404 Not Found)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Falha Alergénio {{$timestamp}}",
  "description": "ID com formato válido mas inexistente",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}",
  "allergenIds": [
    "{{missingId}}"
  ]
}

?? status == 404

### 2.9 Falha Joi: Formato inválido nos Alergénios e Tipo de Componente (400 Bad Request)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Falha Joi Arrays e IDs {{$timestamp}}",
  "description": "Teste Formatos",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}",
  "pizzaComponentTypeId": "id_invalido",
  "allergenIds": [
    "outro_invalido"
  ]
}

?? status == 400

### 2.10 Falha Joi: Alergénios Duplicados no Array (400 Bad Request)
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Alergénios Repetidos {{$timestamp}}",
  "description": "Teste uniqueItems do Joi",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}",
  "allergenIds": [
    "{{allergenId}}",
    "{{allergenId}}"
  ]
}

?? status == 400

### ==========================================
### 3: PESQUISA E CONSULTAS (GET)
### ==========================================

### 3.1 GET Listar Todos os Produtos (200 OK)
GET {{baseUrl}}/products
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.2 GET Pesquisa Parcial por Texto (200 OK)
GET {{baseUrl}}/products?search=Massa
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.3 GET Por ID Válido (200 OK)
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.4 GET Por ID com Formato Inválido (400 Bad Request - Joi)
GET {{baseUrl}}/products/abc
Authorization: Bearer {{adminToken}}

?? status == 400

### 3.5 GET Por ID Inexistente (404 Not Found)
GET {{baseUrl}}/products/{{missingId}}
Authorization: Bearer {{adminToken}}

?? status == 404

### 3.6 GET Filtrar por Categoria (200 OK)
GET {{baseUrl}}/products?categoryId={{categoryId}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 3.7 GET Filtrar por Produtos Inativos (200 OK)
# Deve retornar os produtos que desativaste anteriormente
GET {{baseUrl}}/products?isActive=false
Authorization: Bearer {{adminToken}}

?? status == 200


### ==========================================
### 4: ATUALIZAÇÃO E VALIDAÇÕES DO PATCH
### ==========================================

### 4.1 PATCH Válido - Atualização Parcial de Nome (200 OK)
# @name updateProduct
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Massa Fina Integral Atualizada {{$timestamp}}"
}

?? status == 200

### Guarda o novo nome para garantir a duplicação no 4.8
@patchedName = {{updateProduct.name}}

### 4.2 PATCH Nular Ref de Componente e Limpar Alergénios (200 OK)
# Verifica na resposta se `isPizzaComponent` passou para `false`
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "pizzaComponentTypeId": null,
  "allergenIds": []
}

?? status == 200

### 4.3 Regra de Negócio no PATCH: Tornar vendável sem fornecer preço (400 Bad Request)
# Como o produto do passo 2.1 foi criado com price 0 e sellable false, 
# se não enviarmos price aqui, ele tentará usar o price 0 (que é válido) 
# Para forçar o erro, vamos enviar um preço negativo
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sellable": true,
  "price": -5.0
}

?? status == 400

### 4.4 Falha Joi: Body Vazio (400 Bad Request)
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

?? status == 400

### 4.5 PATCH Desativar Produto (Soft Delete) (200 OK)
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

?? status == 200

### 4.6 PATCH Integridade Referencial: Atualizar para um Alergénio Inexistente (404 Not Found)
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "allergenIds": [
    "{{missingId}}"
  ]
}

?? status == 404

### 4.7 PATCH Integridade Referencial: Atualizar para um Tipo de Componente Inexistente (404 Not Found)
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "pizzaComponentTypeId": "{{missingId}}"
}

?? status == 404

### 4.8 POST Produto com Nome Duplicado (409 Conflict)
# Usa exatamente o mesmo nome gerado no passo 4.1
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{patchedName}}", 
  "description": "Tentativa de duplicar o nome",
  "price": 10,
  "sellable": true,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}

?? status == 409

### 4.9 Setup: Criar uma categoria descartável, sem produtos (201 Created)
# A categoria de referência (categoryId) já tem produtos ativos e não pode ser removida (409).
# @name createDisposableCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria Descartavel {{$timestamp}}"
}

?? status == 201

### Guarda Categoria Descartável
@disposableCategoryId = {{createDisposableCategory.id}}

### 4.9.1 Setup: Desativar a categoria descartável (204 No Content)
DELETE {{baseUrl}}/product-categories/{{disposableCategoryId}}
Authorization: Bearer {{adminToken}}

?? status == 204

### 4.10 POST Produto com Categoria Inativa (404 Not Found)
# A BD tem o ID, mas como está inativa, a regra de domínio bloqueia
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Produto Categoria Inativa {{$timestamp}}",
  "description": "Teste Inativo",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{disposableCategoryId}}"
}

?? status == 404

### ==========================================
### 5: SEGURANÇA E ACESSOS (RBAC)
### ==========================================

### 5.1 POST Sem Token (401 Unauthorized)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Sem Token {{$timestamp}}",
  "description": "Teste",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}"
}

?? status == 401

### 5.2 PATCH Sem Token (401 Unauthorized)
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json

{
  "name": "Tentativa sem token {{$timestamp}}"
}

?? status == 401