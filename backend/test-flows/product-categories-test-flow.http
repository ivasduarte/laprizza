@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicEmail = real_{{$timestamp}}@laprizza.pt

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Admin (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json
 
{
  "identifier": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200
 
### Extração do Token do Manager
@adminToken = {{loginAdmin.token}}

### ==========================================
### 2: CRIAÇÃO E VALIDAÇÕES DO CLIENTE
### ==========================================

### 2.0 POST Categoria de referência (201 Created)
# O nome é um número aleatório. Serve para tornar únicos, em cada execução, os nomes dos pedidos seguintes
# (o mesmo valor é reutilizado, o que permite testar maiúsculas/acentos sobre o mesmo nome).
# @name createProductCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "{{$randomInt 100000 999999}}"
}

?? status == 201
 
### Variáveis
@runId = {{createProductCategory.name}}
@seedCategoryId = {{createProductCategory.id}}

### 2.1 POST Categoria nova (201 Created)
# @name createCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "Café {{runId}}"
}

?? status == 201
 
### Variáveis
@categoryId = {{createCategory.id}}
@createdName = {{createCategory.name}}

### 2.2 POST Nome duplicado, igual (409 Conflict)
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "{{createdName}}"
}

?? status == 409

### 2.3 POST Nome duplicado, com outras maiúsculas e sem acento (409 Conflict - colação do índice único)
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "CAFE {{runId}}"
}

?? status == 409

### 2.4 POST Nome só com espaços (400 Bad Request)
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "   "
}

?? status == 400
 
### 2.5 POST Sem nome - Joi (400 Bad Request)
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "description": "campo errado"
}

?? status == 400

### 2.6 POST Nome que não é texto - Joi (400 Bad Request)
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": 123
}

?? status == 400
 
### 2.7 POST Sem token (401 Unauthorized)
POST {{baseUrl}}/product-categories
Content-Type: application/json
 
{
  "name": "Sem Token {{runId}}"
}

?? status == 401

### 2.8 POST Espaços a mais são normalizados (201 Created - o nome devolvido é "Sopa {{runId}}")
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "   Sopa     {{runId}}   "
}

?? status == 201

### ==========================================
### 3: PESQUISA E CONSULTAS
### ==========================================

### 3. GET Listar Todas (200 OK)
GET {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 3.1 GET Pesquisa por nome exato, ignorando maiúsculas e acentos (200 OK - devolve 1 categoria)
GET {{baseUrl}}/product-categories?name=CAFE%20{{runId}}
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 3.2 GET Pesquisa por nome parcial (200 OK - devolve [])
GET {{baseUrl}}/product-categories?name=Caf
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 3.3 GET Pesquisa por nome inexistente (200 OK - devolve [])
GET {{baseUrl}}/product-categories?name=NomeQueNaoExiste
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 3.4 GET Pesquisa com nome vazio (200 OK - devolve [])
GET {{baseUrl}}/product-categories?name=
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 3.5 GET Sem token (401 Unauthorized)
GET {{baseUrl}}/product-categories

?? status == 401
 
### 4. GET Por ID (200 OK)
GET {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 4.1 GET ID com formato inválido (400 Bad Request)
GET {{baseUrl}}/product-categories/id_invalido
Authorization: Bearer {{adminToken}}

?? status == 400
 
### 4.2 GET ID válido mas inexistente (404 Not Found)
GET {{baseUrl}}/product-categories/000000000000000000000000
Authorization: Bearer {{adminToken}}

?? status == 404

### ==========================================
### 4: ATUALIZAÇÃO E VALIDAÇÕES DO PUT
### ==========================================

### 5. PUT Mudar só as maiúsculas do próprio nome (200 OK - não entra em conflito consigo própria)
PUT {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "café {{runId}}"
}

?? status == 200
 
### 5.1 PUT Nome de outra categoria (409 Conflict - usa a categoria de referência 2.0)
PUT {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "{{runId}}"
}

?? status == 409
 
### 5.2 PUT Nome só com espaços (400 Bad Request)
PUT {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "   "
}

?? status == 400
 
### 5.3 PUT Sem nome - Joi (400 Bad Request)
PUT {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{}

?? status == 400
 
### 5.4 PUT ID com formato inválido (400 Bad Request)
PUT {{baseUrl}}/product-categories/id_invalido
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "Qualquer"
}

?? status == 400
 
### 5.5 PUT ID válido mas inexistente (404 Not Found)
PUT {{baseUrl}}/product-categories/000000000000000000000000
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "Qualquer {{runId}}"
}

?? status == 404
 
### 5.6 PUT Válido - Mudar o nome (200 OK)
PUT {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
 
{
  "name": "Bebidas {{runId}}"
}

?? status == 200

### ==========================================
### 5: REMOÇÃO
### ==========================================
# Atenção: a remoção precisa do repositório de produtos (BCK05) para verificar se a categoria está em uso.
# Enquanto o BCK05 não existir, o pedido 6.3 pode falhar com 500, e o caso 409 (categoria em uso) não é testável aqui.
 
### 6. DELETE ID com formato inválido (400 Bad Request)
DELETE {{baseUrl}}/product-categories/id_invalido
Authorization: Bearer {{adminToken}}

?? status == 400
 
### 6.1 DELETE ID válido mas inexistente (404 Not Found)
DELETE {{baseUrl}}/product-categories/000000000000000000000000
Authorization: Bearer {{adminToken}}

?? status == 404
 
### 6.2 DELETE Sem token (401 Unauthorized)
DELETE {{baseUrl}}/product-categories/{{categoryId}}

?? status == 401
 
### 6.3 DELETE Categoria sem produtos (204 No Content)
DELETE {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

?? status == 204
 
### 6.4 GET Categoria removida (200 Ok - isActive: false)
GET {{baseUrl}}/product-categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

?? status == 200
 
### 6.5 DELETE Categoria de referência (204 No Content - limpeza)
DELETE {{baseUrl}}/product-categories/{{seedCategoryId}}
Authorization: Bearer {{adminToken}}

?? status == 204
 
### 6.6 (Quando o BCK05 existir) Criar um produto com esta categoria e tentar remover a categoria (409 Conflict - AC5)
# POST {{baseUrl}}/products ... com a categoria criada, seguido de DELETE da categoria.