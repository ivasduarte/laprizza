@baseUrl = http://localhost:3000/api/v2
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicEmail = aa06_{{$timestamp}}@laprizza.pt
# Contas de desenvolvimento (AA06): npm run seed:dev-users -- --confirm com
# SEED_DEV_PASSWORD=LaPrizzaDev_013DI! (desde a AA06 não se criam contas com password por API).
@devPassword = LaPrizzaDev_013DI!
# manager.employee@laprizza.pt: alteração de password e desativação (reposta no 6.3).
@seedUserEmail = manager.employee@laprizza.pt

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Admin (Seeder)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

?? status == 200

### Extração de variáveis base
@token = {{login.accessToken}}

### 1.2 Login com Username (400 Bad Request - AA01: o identificador de login é só o email)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin",
  "password": "{{managerPassword}}"
}

?? status == 400

### 1.3 Login sem password (400 Bad Request)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}"
}

?? status == 400

### 1.4 Login com password errada (401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "WrongPassword999!"
}

?? status == 401


### ==========================================
### 2: CRIAÇÃO DE CONTA E CONVITE DE ATIVAÇÃO (AA06)
### ==========================================

### 2. POST Conta nova, sem password (201 Created - inativa, CUSTOMER automático, convite enviado)
# O convite aparece no Mailpit (http://localhost:8025); "sent" é false se o Mailpit não estiver a correr.
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{dynamicEmail}}",
  "roles": ["EMPLOYEE"]
}

?? status == 201
?? js response.parsedBody.status == inactive
?? js response.parsedBody.pendingActivation == true
?? js response.parsedBody.roles.includes('CUSTOMER') == true
?? js response.parsedBody.roles.includes('EMPLOYEE') == true
?? js response.parsedBody.invitation.expiresAt exists

### Extração do estado (Email Fixo e ID)
@userId = {{createUser.id}}
@createdEmail = {{createUser.email}}

### 2.1 POST com password (400 Bad Request - a password é definida pelo utilizador na ativação)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "outro_{{$timestamp}}@laprizza.pt",
  "password": "StrongPassword123!"
}

?? status == 400

### 2.2 Login da conta nova (401 Unauthorized - ainda não tem password nem está ativa)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{createdEmail}}",
  "password": "StrongPassword123!"
}

?? status == 401

### 2.3 Ativar a conta pelo Administrator (409 Conflict - só pelo convite)
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true
}

?? status == 409
?? js response.parsedBody.error.code == ACTIVATION_REQUIRED

### 2.4 POST Novo convite (201 Created - o anterior deixa de funcionar)
POST {{baseUrl}}/users/{{userId}}/invitation
Authorization: Bearer {{token}}

?? status == 201
?? js response.parsedBody.expiresAt exists

### 3. POST Duplicado usando o email fixo (409 Conflict - Prova índice unique do email)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{createdEmail}}",
  "roles": ["EMPLOYEE"]
}

?? status == 409

### 3.1 POST Duplicado usando username do Admin (409 Conflict - Prova índice unique do username)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "outro_email_{{$timestamp}}@laprizza.pt",
  "username": "admin",
  "roles": ["EMPLOYEE"]
}

?? status == 409


### ==========================================
### 3: CONSULTAS E AUTO-PROTEÇÃO
### ==========================================

### 4. GET Lista
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

?? status == 200

### 4.1 GET Sessão atual (para obter o id do Admin)
# @name me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.roles.includes('ADMINISTRATOR') == true

@adminId = {{me.id}}

### 4.2 PATCH Auto-proteção do Admin (403 Forbidden)
PATCH {{baseUrl}}/users/{{adminId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": false
}

?? status == 403

### 5. GET Por ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

?? status == 200

### 5.1 GET ID Inexistente Válido (404 Not Found - Prova devolução null do Mongoose)
GET {{baseUrl}}/users/000000000000000000000000
Authorization: Bearer {{token}}

?? status == 404

### 5.2 GET ID Inválido (400 Bad Request - Prova bloqueio do Joi evitando CastError)
GET {{baseUrl}}/users/abc
Authorization: Bearer {{token}}

?? status == 400

### 5.3 PUT Adicionar role (200 OK - sem nova ativação)
PUT {{baseUrl}}/users/{{userId}}/roles/MANAGER
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.roles.includes('MANAGER') == true

### 5.4 PUT Role desconhecida (400 Bad Request)
PUT {{baseUrl}}/users/{{userId}}/roles/ROOT
Authorization: Bearer {{token}}

?? status == 400

### 5.5 DELETE Remover role (200 OK)
DELETE {{baseUrl}}/users/{{userId}}/roles/MANAGER
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.roles.includes('MANAGER') == false

### 5.6 PUT Alterar as próprias roles (403 Forbidden - SELF_ROLE_CHANGE)
PUT {{baseUrl}}/users/{{adminId}}/roles/EMPLOYEE
Authorization: Bearer {{token}}

?? status == 403
?? js response.parsedBody.error.code == SELF_ROLE_CHANGE

### 5.7 GET Histórico de roles (200 OK - CUSTOMER pelo processo AA03, EMPLOYEE e MANAGER pelo Admin)
GET {{baseUrl}}/users/{{userId}}/role-history
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.length >= 4
?? js response.parsedBody[0].actor.userId == {{adminId}}

### 5.8 GET Roles que o Administrator pode atribuir (200 OK)
GET {{baseUrl}}/users/assignable-roles
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.roles.includes('ADMINISTRATOR') == true

### 5.9 Login de um Manager sem Administrator (conta manager@laprizza.pt do seed)
# @name loginManager
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "manager@laprizza.pt",
  "password": "{{devPassword}}"
}

?? status == 200

### 5.10 O Manager não administra utilizadores (403 Forbidden - AA06)
GET {{baseUrl}}/users
Authorization: Bearer {{loginManager.accessToken}}

?? status == 403


### ==========================================
### 4: PASSWORD E DESATIVAÇÃO (conta do seed, reposta no fim)
### ==========================================

### 6. Login da conta do seed (200 OK)
# @name loginSeedUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{seedUserEmail}}",
  "password": "{{devPassword}}"
}

?? status == 200

@seedUserId = {{loginSeedUser.user.id}}

### 6.1 PATCH password pelo Administrator (200 OK)
PATCH {{baseUrl}}/users/{{seedUserId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "NewStrongPassword123!"
}

?? status == 200

### 6.2 Login com a password antiga (401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{seedUserEmail}}",
  "password": "{{devPassword}}"
}

?? status == 401

### 6.3 PATCH Desativar a conta (200 OK - sessões e convites pendentes revogados)
PATCH {{baseUrl}}/users/{{seedUserId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": false
}

?? status == 200
?? js response.parsedBody.status == disabled

### 7. Login de Conta Desativada com a nova password (403 Forbidden - ACCOUNT_DISABLED)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{seedUserEmail}}",
  "password": "NewStrongPassword123!"
}

?? status == 403
?? js response.parsedBody.error.code == ACCOUNT_DISABLED

### 7.1 Repor a conta do seed: reativar (já tinha sido ativada) e voltar à password do seed (200 OK)
PATCH {{baseUrl}}/users/{{seedUserId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": true,
  "password": "{{devPassword}}"
}

?? status == 200
?? js response.parsedBody.status == active
