@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicName = Cenario_{{$timestamp}}
@missingId = 507f1f77bcf86cd799439011

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Manager (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}
?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.accessToken}}

### ==========================================
### 2: DADOS DE SUPORTE (produto usado nas ofertas)
### ==========================================

### 2. POST Categoria de suporte (201 Created)
# @name createCategoryRef
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria Cenario {{$timestamp}}"
}
?? status == 201

### Variáveis
@categoryId = {{createCategoryRef.id}}

### 2.1 POST Produto de suporte (201 Created)
# @name createProductRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Produto Cenario {{$timestamp}}",
  "description": "Produto para ofertas de fornecedores",
  "sellable": false,
  "stockControlled": false,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@productId = {{createProductRef.id}}

### ==========================================
### 3: CRIAÇÃO E VALIDAÇÕES (POST)
### ==========================================

### 3. POST Cenário Novo - com espaços à volta para provar o trim (201 Created)
# @name createScenario
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "   {{dynamicName}}   ",
  "simulated": true,
  "suppliers": [
    { "id": "SUP-1", "name": "Fornecedor A" },
    { "id": "SUP-2", "name": "Fornecedor B" }
  ],
  "products": [
    {
      "productId": "{{productId}}",
      "offers": [
        {
          "supplierId": "SUP-1",
          "priceEur": 1.5,
          "stockUnits": 100,
          "leadTimeDays": 2,
          "supplyLimit": 50
        },
        {
          "supplierId": "SUP-2",
          "priceEur": 0,
          "stockUnits": 1,
          "leadTimeDays": 0
        }
      ]
    }
  ]
}
?? status == 201

### Variáveis
@scenarioId = {{createScenario.id}}
@createdName = {{createScenario.name}}

### 3.1 POST Nome Duplicado (mesma versão) (409 Conflict)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "suppliers": [],
  "products": []
}
?? status == 409

### 3.2 POST Nome Duplicado com outras maiúsculas (409 Conflict)
# Altera manualmente o nome abaixo para MAIÚSCULAS (ex.: CENARIO_1760000000)
# para validar que a unicidade ignora maiúsculas/minúsculas.
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "suppliers": [],
  "products": []
}
?? status == 409

### 3.3 POST Mesmo nome com outra versão (201 Created - versões diferentes são permitidas)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "version": 2,
  "suppliers": [],
  "products": []
}
?? status == 201

