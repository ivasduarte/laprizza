@baseUrl = http://localhost:3000/api/v2
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicName = Cenario_{{$timestamp}}
@missingId = 507f1f77bcf86cd799439011

# WEB07 - Cenários de fornecedores (JSON manual ou preparado com LLM):
# - imutáveis e versionados como os forecasts: o mesmo nome cria a versão seguinte; a "version"
#   enviada é ignorada e as ofertas ficam sempre simulated = true;
# - um fornecedor sem name usa o id como nome;
# - regras de negócio (400, error.details[].type): productUnknown, productDuplicate,
#   supplierIdDuplicate, offerSupplierUnknown, offerDuplicate;
# - um pedido rejeitado não grava nada: o cenário anterior fica intacto.

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Manager (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}
?? status == 200

### Extração do Token do Manager
@adminToken = {{loginAdmin.accessToken}}

### ==========================================
### 2: DADOS DE SUPORTE (produtos usados nas ofertas)
### ==========================================

### 2. POST Categoria de suporte (201 Created)
# @name createCategoryRef
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Categoria Cenario {{$timestamp}}"
}
?? status == 201

### Variáveis
@categoryId = {{createCategoryRef.id}}

### 2.1 POST Matéria-prima com controlo de stock (201 Created)
# @name createProductRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Materia Prima Cenario {{$timestamp}}",
  "description": "Produto com duas ofertas de fornecedores",
  "sellable": false,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@productId = {{createProductRef.id}}

### 2.2 POST Segunda matéria-prima, sem ofertas (201 Created)
# @name createProductNoOffersRef
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Materia Prima Sem Fornecedor {{$timestamp}}",
  "description": "Produto sem fornecedor configurado",
  "sellable": false,
  "stockControlled": true,
  "categoryId": "{{categoryId}}"
}
?? status == 201

### Variáveis
@productNoOffersId = {{createProductNoOffersRef.id}}

### 2.3 GET Export de produtos para o ficheiro de fornecedores (200 OK, inclui as matérias-primas)
GET {{baseUrl}}/ai-data/products/export
Authorization: Bearer {{adminToken}}
?? status == 200
?? js response.parsedBody.products.some((p) => p.id === productId && p.kind === 'rawMaterial') == true

### ==========================================
### 3: CRIAÇÃO E VERSÕES (POST)
### ==========================================

### 3. POST Cenário novo - 2 ofertas para o mesmo produto + produto sem ofertas (201, v1)
# @name createScenario
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "   {{dynamicName}}   ",
  "suppliers": [
    { "id": "SUP-1", "name": "Fornecedor A" },
    { "id": "SUP-2", "name": "Fornecedor B" }
  ],
  "products": [
    {
      "productId": "{{productId}}",
      "offers": [
        { "supplierId": "SUP-1", "priceEur": 1.5, "stockUnits": 100, "leadTimeDays": 2, "supplyLimit": 50 },
        { "supplierId": "SUP-2", "priceEur": 0, "stockUnits": 1, "leadTimeDays": 0 }
      ]
    },
    { "productId": "{{productNoOffersId}}", "offers": [] }
  ]
}
?? status == 201
?? js response.parsedBody.name === response.parsedBody.name.trim() == true
?? js response.parsedBody.version == 1
?? js response.parsedBody.simulated == true
?? js response.parsedBody.products[0].offers.length == 2
?? js response.parsedBody.products[1].offers.length == 0

### Variáveis
@scenarioId = {{createScenario.id}}
@createdName = {{createScenario.name}}

### 3.1 POST Mesmo nome - cria a versão seguinte, a v1 mantém-se (201, v2)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "suppliers": [],
  "products": []
}
?? status == 201
?? js response.parsedBody.version == 2

### 3.2 POST Mesmo nome em MAIÚSCULAS - a versão ignora maiúsculas/minúsculas (201, v3)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName.toUpperCase()}}",
  "suppliers": [],
  "products": []
}
?? status == 201
?? js response.parsedBody.version == 3

### 3.3 POST version e simulated:false enviados são ignorados (201, v4, simulated = true)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{createdName}}",
  "version": 99,
  "simulated": false,
  "suppliers": [],
  "products": []
}
?? status == 201
?? js response.parsedBody.version == 4
?? js response.parsedBody.simulated == true

### 3.4 GET A v1 continua igual depois das novas versões (200 OK)
GET {{baseUrl}}/supplier-scenarios/{{scenarioId}}
Authorization: Bearer {{adminToken}}
?? status == 200
?? js response.parsedBody.version == 1
?? js response.parsedBody.products[0].offers.length == 2

### 3.5 POST Fornecedor sem name - usa o id como nome (201 Created)
POST {{baseUrl}}/supplier-scenarios
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Supplier_SemNome_{{$timestamp}}",
  "suppliers": [
    { "id": "SUP-9" }
  ],
  "products": []
}
?? status == 201
?? js response.parsedBody.suppliers[0].name == SUP-9

