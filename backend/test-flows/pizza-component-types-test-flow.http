PUT {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "café {{runId}}",
  "assemblyOrder": {{seedOrder}},
  "minQuantity": 1,
  "maxQuantity": 3
}

?? status == 409

