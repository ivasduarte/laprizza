@baseUrl = http://localhost:3000/api/v1
@managerEmail = admin@laprizza.pt
@managerPassword = LaPrizzaAdmin_013DI!
@dynamicEmail = real_{{$timestamp}}@laprizza.pt

### ==========================================
### 1: AUTENTICAÇÃO
### ==========================================

### 1.1 Login do Admin (Seeder)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json
 
{
  "identifier": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}
 
### Extração do Token do Manager
@adminToken = {{loginAdmin.response.body.$.token}}

### ==========================================
### 2: CRIAÇÃO E VALIDAÇÕES DO TIPO DE COMPONENTES DA PIZZA
### ==========================================

# A ordem de montagem é única entre os tipos ativos e os 4 tipos iniciais ocupam as ordens 1 a 4.
# Por isso cada tipo criado usa um intervalo próprio de ordens altas (aleatórias), guardado a partir da resposta.
# O nome do tipo de referência é um número aleatório, reutilizado nos nomes seguintes para serem únicos em cada execução.

### 2.0 POST Tipo de referência (201 Created)
# @name createReferenceType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{$randomInt 100000 999999}}",
  "assemblyOrder": {{$randomInt 10000 19999}},
  "minQuantity": 0,
  "maxQuantity": 1
}

### Variáveis
@runId = {{createReferenceType.response.body.$.name}}
@seedTypeId = {{createReferenceType.response.body.$.id}}
@seedOrder = {{createReferenceType.response.body.$.assemblyOrder}}

### 2.1 POST Tipo novo (201 Created - isActive: true)
# @name createType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Café {{runId}}",
  "assemblyOrder": {{$randomInt 20000 29999}},
  "minQuantity": 1,
  "maxQuantity": 3
}

### Variáveis
@typeId = {{createType.response.body.$.id}}
@typeName = {{createType.response.body.$.name}}
@typeOrder = {{createType.response.body.$.assemblyOrder}}

### 2.2 POST Sem máximo (201 Created - maxQuantity: null, ilimitado)
# @name createUnboundedType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Sem Maximo {{runId}}",
  "assemblyOrder": {{$randomInt 30000 39999}},
  "minQuantity": 0
}

### Variáveis
@unboundedId = {{createUnboundedType.response.body.$.id}}

### 2.3 POST Máximo null explícito (201 Created - maxQuantity: null, ilimitado)
# @name createNullMaxType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Maximo Nulo {{runId}}",
  "assemblyOrder": {{$randomInt 40000 49999}},
  "minQuantity": 0,
  "maxQuantity": null
}

### Variáveis
@nullMaxId = {{createNullMaxType.response.body.$.id}}

### 2.4 POST Mínimo igual ao máximo (201 Created)
# @name createEqualType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Igual {{runId}}",
  "assemblyOrder": {{$randomInt 50000 59999}},
  "minQuantity": 1,
  "maxQuantity": 1
}

### Variáveis
@equalId = {{createEqualType.response.body.$.id}}

### 2.5 POST isActive enviado pelo cliente é ignorado (201 Created - isActive: true)
# @name createIgnoreActiveType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ignora Ativo {{runId}}",
  "assemblyOrder": {{$randomInt 60000 69999}},
  "minQuantity": 0,
  "maxQuantity": 2,
  "isActive": false
}

### Variáveis
@ignoreActiveId = {{createIgnoreActiveType.response.body.$.id}}
@ignoreActiveOrder = {{createIgnoreActiveType.response.body.$.assemblyOrder}}

### 2.6 POST Espaços a mais são normalizados (201 Created - o nome devolvido é "Sopa {{runId}}")
# @name createNormalizedType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "   Sopa     {{runId}}   ",
  "assemblyOrder": {{$randomInt 70000 79999}},
  "minQuantity": 0,
  "maxQuantity": 5
}

### Variáveis
@normalizedId = {{createNormalizedType.response.body.$.id}}

### 2.7 POST Nome duplicado, igual (409 Conflict)
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{typeName}}",
  "assemblyOrder": {{$randomInt 80000 89999}},
  "minQuantity": 0,
  "maxQuantity": 1
}

### 2.8 POST Nome duplicado, com outras maiúsculas e sem acento (409 Conflict - colação do índice único)
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "CAFE {{runId}}",
  "assemblyOrder": {{$randomInt 80000 89999}},
  "minQuantity": 0,
  "maxQuantity": 1
}

### 2.9 POST Ordem de montagem duplicada (409 Conflict)
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ordem Repetida {{runId}}",
  "assemblyOrder": {{typeOrder}},
  "minQuantity": 0,
  "maxQuantity": 1
}

### 2.10 POST Ordem de montagem de um tipo inicial (409 Conflict - a ordem 1 é do Base Dough; requer o seeder)
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ordem Inicial {{runId}}",
  "assemblyOrder": 1,
  "minQuantity": 0,
  "maxQuantity": 1
}

