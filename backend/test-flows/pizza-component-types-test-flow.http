### 5.9 PUT isActive enviado pelo cliente é ignorado (200 OK - isActive continua true)
PUT {{baseUrl}}/pizza-component-type/{{ignoreActiveId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ignora Ativo {{runId}}",
  "assemblyOrder": {{ignoreActiveOrder}},
  "minQuantity": 0,
  "maxQuantity": 2,
  "isActive": false
}

?? status == 200

### 5.10 PUT Válido - Mudar nome, ordem e limites (200 OK - o máximo passa a ilimitado)
# @name updateType
PUT {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Queijo {{runId}}",
  "assemblyOrder": {{$randomInt 90000 99999}},
  "minQuantity": 0,
  "maxQuantity": null
}

?? status == 200

### Variáveis
@updatedName = {{updateType.name}}
@updatedOrder = {{updateType.assemblyOrder}}

### ==========================================
### 6: REMOÇÃO (SOFT DELETE)
### ==========================================
# Um tipo referenciado por produtos ativos não pode ser removido (409 Conflict).
# Um produto inativo não bloqueia a remoção do tipo.

### 6. DELETE ID com formato inválido (400 Bad Request)
DELETE {{baseUrl}}/pizza-component-type/id_invalido
Authorization: Bearer {{adminToken}}

?? status == 400

### 6.1 DELETE ID válido mas inexistente (404 Not Found)
DELETE {{baseUrl}}/pizza-component-type/000000000000000000000000
Authorization: Bearer {{adminToken}}

?? status == 404

### 6.2 DELETE Sem token (401 Unauthorized)
DELETE {{baseUrl}}/pizza-component-type/{{typeId}}

?? status == 401

### 6.3 DELETE Tipo sem produtos (204 No Content)
DELETE {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}

?? status == 204

### 6.4 GET Tipo removido por ID (200 OK - isActive: false)
GET {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 6.5 GET Listar Todos (200 OK - o tipo removido já não aparece)
GET {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}

?? status == 200

### 6.6 GET Pesquisa por nome do tipo removido (200 OK - devolve 1 tipo com isActive: false)
GET {{baseUrl}}/pizza-component-type?name=queijo%20{{runId}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 6.7 DELETE Tipo já removido (404 Not Found)
DELETE {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}

?? status == 404

### 6.8 PUT Tipo removido (404 Not Found - não pode ser editado)
PUT {{baseUrl}}/pizza-component-type/{{typeId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Outro Nome {{runId}}",
  "assemblyOrder": {{updatedOrder}},
  "minQuantity": 0,
  "maxQuantity": null
}

?? status == 404

### 6.9 POST Reutilizar o nome e a ordem do tipo removido (201 Created - os índices únicos só contam tipos ativos)
# @name recreateType
POST {{baseUrl}}/pizza-component-type
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{updatedName}}",
  "assemblyOrder": {{updatedOrder}},
  "minQuantity": 0,
  "maxQuantity": null
}

?? status == 201

### Variáveis
@recreatedId = {{recreateType.id}}

### ==========================================
### 6B: TIPO REFERENCIADO POR PRODUTOS
### ==========================================
# Usa o tipo "Igual" (2.4). O produto criado fica inativo no fim, porque os produtos não podem ser apagados.

### 6.10 POST Categoria de apoio para o produto (201 Created)
# @name createCategory
POST {{baseUrl}}/product-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Componentes {{runId}}"
}

?? status == 201

### Variáveis
@categoryId = {{createCategory.id}}

### 6.11 POST Produto que usa o tipo (201 Created - isPizzaComponent: true)
# @name createProduct
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Mozzarella {{runId}}",
  "description": "Componente que referencia o tipo",
  "sellable": false,
  "stockControlled": true,
  "categoryId": "{{categoryId}}",
  "pizzaComponentTypeId": "{{equalId}}"
}

?? status == 201

### Variáveis
@productId = {{createProduct.id}}

### 6.12 DELETE Tipo referenciado por um produto ativo (409 Conflict)
DELETE {{baseUrl}}/pizza-component-type/{{equalId}}
Authorization: Bearer {{adminToken}}

?? status == 409

### 6.13 GET Tipo continua ativo depois do 409 (200 OK - isActive: true)
GET {{baseUrl}}/pizza-component-type/{{equalId}}
Authorization: Bearer {{adminToken}}

?? status == 200

### 6.14 PATCH Desativar o produto (200 OK - isActive: false)
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

?? status == 200

### 6.15 DELETE Tipo cujo produto está inativo (204 No Content - os produtos inativos não bloqueiam)
DELETE {{baseUrl}}/pizza-component-type/{{equalId}}
Authorization: Bearer {{adminToken}}

?? status == 204

