{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kitchen Configuration",
  "type": "object",
  "properties": {
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["width", "length", "height"]
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["equipment", "assembly-line", "decoration", "tool"]
          },
          "modelReference": { "type": "string", "format": "uri-reference" },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "rotation": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "scale": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "exclusiveMinimum": 0 },
              "y": { "type": "number", "exclusiveMinimum": 0 },
              "z": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "z"]
          },
          "material": {
            "type": "object",
            "properties": {
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "roughnessMap": { "type": "string", "format": "uri-reference" },
              "bumpMap": { "type": "string", "format": "uri-reference" },
              "normalMap": { "type": "string", "format": "uri-reference" }
            }
          }
        },
        "required": ["id", "type", "modelReference", "position", "rotation", "scale"]
      }
    }
  },
  "required": ["dimensions", "elements"]
}