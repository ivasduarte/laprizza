{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kitchen Configuration",
  "type": "object",
  "definitions": {
    "material": {
      "description": "Textures and material properties of a 3D object (VIS04). Texture maps are absolute http(s) URLs or root-relative paths; a textured material needs a colorMap and at least one of roughnessMap, bumpMap or normalMap.",
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "colorMap": { "type": "string", "format": "uri-reference" },
        "roughnessMap": { "type": "string", "format": "uri-reference" },
        "bumpMap": { "type": "string", "format": "uri-reference" },
        "normalMap": { "type": "string", "format": "uri-reference" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "repeat": {
          "description": "How many times the textures repeat across the surface.",
          "type": "object",
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["width", "length", "height"]
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["equipment", "assembly-line", "decoration", "tool"]
          },
          "model": {
            "description": "Optional. Procedural kitchen furniture model (VIS03) for decoration and tool elements, built at the size given by scale (metres), standing on y = 0 with its front towards +z.",
            "type": "string",
            "enum": ["work-table", "fridge", "shelves", "cabinet", "ingredient-bins", "dough-trays"]
          },
          "modelReference": {
            "description": "Optional. Imported model URL (absolute http(s) URL or root-relative path). When absent, the element is created procedurally from its type (VIS03).",
            "type": "string",
            "format": "uri-reference"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "rotation": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "scale": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "exclusiveMinimum": 0 },
              "y": { "type": "number", "exclusiveMinimum": 0 },
              "z": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "z"]
          },
          "material": { "$ref": "#/definitions/material" }
        },
        "required": ["id", "type", "position", "rotation", "scale"]
      }
    },
    "floor": {
      "description": "Kitchen floor (VIS04).",
      "type": "object",
      "properties": {
        "material": { "$ref": "#/definitions/material" }
      },
      "additionalProperties": false
    },
    "assemblyLine": {
      "description": "Placement of the automated pizza assembly line (VIS03). References an Assembly Line Configuration, resolved by the back end (WEB06).",
      "type": "object",
      "properties": {
        "configurationId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"]
        },
        "rotation": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "required": ["x", "y", "z"]
        }
      },
      "required": ["configurationId", "position", "rotation"],
      "additionalProperties": false
    }
  },
  "required": ["dimensions", "elements"]
}
