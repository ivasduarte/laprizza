{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assembly Line Configuration",
  "description": "Definition of an assembly line in its own local coordinate system (origin at the line origin). The kitchen configuration places the line in the kitchen through content.assemblyLine.",
  "type": "object",
  "definitions": {
    "material": {
      "description": "Textures and material properties of a 3D object (VIS04). Texture maps are absolute http(s) URLs or root-relative paths; a textured material needs a colorMap and at least one of roughnessMap, bumpMap or normalMap.",
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "colorMap": { "type": "string", "format": "uri-reference" },
        "roughnessMap": { "type": "string", "format": "uri-reference" },
        "bumpMap": { "type": "string", "format": "uri-reference" },
        "normalMap": { "type": "string", "format": "uri-reference" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
        "repeat": {
          "description": "How many times the textures repeat across the surface.",
          "type": "object",
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "dimensions": {
      "description": "Footprint of the line (bounding box in local coordinates).",
      "type": "object",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["width", "length", "height"]
    },
    "elements": {
      "description": "Line elements; position, rotation and scale are relative to the line origin.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "description": "VIS03 components: counter, receiving-platform, crust-dispenser (overhead crust supply), conveyor-belt, robotic-arm, wood-fired-oven. The generic types are kept for compatibility.",
            "type": "string",
            "enum": [
              "counter",
              "receiving-platform",
              "crust-dispenser",
              "conveyor-belt",
              "robotic-arm",
              "wood-fired-oven",
              "equipment",
              "assembly-line",
              "decoration",
              "tool"
            ]
          },
          "modelReference": {
            "description": "Optional. Imported model URL (absolute http(s) URL or root-relative path). When absent, the element is created procedurally from its type (VIS03).",
            "type": "string",
            "format": "uri-reference"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "rotation": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            },
            "required": ["x", "y", "z"]
          },
          "scale": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "exclusiveMinimum": 0 },
              "y": { "type": "number", "exclusiveMinimum": 0 },
              "z": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "z"]
          },
          "material": { "$ref": "#/definitions/material" }
        },
        "required": ["id", "type", "position", "rotation", "scale"]
      }
    }
  },
  "required": ["dimensions", "elements"]
}
