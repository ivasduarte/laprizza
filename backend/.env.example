# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed CORS origin(s), comma-separated. Also checked on POST /auth/refresh and /auth/logout
# (CSRF): it MUST contain the exact public origin of the SPA in each environment, e.g.
#   staging:    https://uvmXXX.dei.isep.ipp.pt
#   production: https://vs-gate.dei.isep.ipp.pt
# A missing origin makes the refresh answer 403 and every F5 ends the session.
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

JWT_SECRET=
RATE_LIMIT_ENABLED=false

SEED_MANAGER_PASSWORD=password1234

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>.mongodb.net/laprizza

# Sessions 
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
# AA04: a session not used for this long ends (0 = only the absolute expiry above)
SESSION_IDLE_TIMEOUT_MINUTES=30
REFRESH_COOKIE_NAME=lp_rt

# Secure cookies are only accepted over HTTPS (or http://localhost): keep true and serve the VMs
# over HTTPS (deploy/nginx/laprizza.conf).
REFRESH_COOKIE_SECURE=true

REFRESH_COOKIE_SAMESITE=strict

# On the VMs (behind nginx) use TRUST_PROXY=loopback, so req.ip is the client (X-Forwarded-For)
TRUST_PROXY=false

# Attempt limits
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
FORGOT_RATE_LIMIT_WINDOW_MINUTES=60
FORGOT_RATE_LIMIT_MAX=3
LOGIN_LOCKOUT_THRESHOLD=3
LOGIN_LOCKOUT_STEPS_SECONDS=60,300,1800
LOGIN_THROTTLE_RETENTION_HOURS=24

# Password recovery
PASSWORD_RESET_TTL_MINUTES=30

# Activation invitations (AA06): validity of the link, in hours
INVITATION_TTL_HOURS=72

# SPA base URL (activation and password-reset links). On the VMs: https://<host of the environment>
APP_BASE_URL=http://localhost:4200

# Email (Mailpit; web UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LaPrizza <no-reply@laprizza.local>

# Shares folder
SHARED_DIR=/srv/laprizza-shared

# External authentication. On the VMs: https://<host of the environment> (redirect URI registered
# at the provider: <API_PUBLIC_URL>/api/v2/auth/external/<provider>/callback)
API_PUBLIC_URL=http://localhost:3000
OIDC_TRANSACTION_TTL_MINUTES=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers