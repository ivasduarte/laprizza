# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed CORS origin(s), comma-separated.
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

JWT_SECRET=
RATE_LIMIT_ENABLED=false

SEED_MANAGER_PASSWORD=password1234

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>.mongodb.net/laprizza

# Sessions 
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=lp_rt

REFRESH_COOKIE_SECURE=true 

REFRESH_COOKIE_SAMESITE=strict

TRUST_PROXY=false

# Attempt limits
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
FORGOT_RATE_LIMIT_WINDOW_MINUTES=60
FORGOT_RATE_LIMIT_MAX=3
LOGIN_LOCKOUT_THRESHOLD=3
LOGIN_LOCKOUT_STEPS_SECONDS=60,300,1800
LOGIN_THROTTLE_RETENTION_HOURS=24

# Password recovery
PASSWORD_RESET_TTL_MINUTES=30

# SPA base URL
APP_BASE_URL=http://localhost:4200

# Email (Mailpit; web UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LaPrizza <no-reply@laprizza.local>

# Shares folder
SHARED_DIR=/srv/laprizza-shared

# External authentication
API_PUBLIC_URL=http://localhost:3000
OIDC_TRANSACTION_TTL_MINUTES=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers