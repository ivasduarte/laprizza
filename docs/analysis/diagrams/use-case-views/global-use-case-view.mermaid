flowchart LR
    Manager([LaPrizza Manager])
    SystemUser([System User])
    Employee([Employee])
    Customer([Customer])

    subgraph System [LaPrizza Information System]
        subgraph Auth [BCK01: Auth & Users]
            UC_Auth(Authenticate / Login)
            UC_Users(Manage Users)
        end
        subgraph Cust [BCK02: Customers]
            UC_Cust(Manage Customers)
        end
        subgraph Catalog [BCK03-05, 11: Catalogue & Products]
            UC_Cat(Manage Categories)
            UC_Allergens(Manage Allergens)
            UC_Prod(Manage Products)
            UC_Catalog(Consult Catalogue)
        end
        subgraph Config [BCK06-08, 10: Pizza Configuration]
            UC_Sizes(Manage Pizza Sizes)
            UC_Types(Manage Component Types)
            UC_Configs(Manage Component Configs)
            UC_Predef(Manage Predefined Pizzas)
        end
        subgraph Stock [BCK09: Stock]
            UC_Stock(Manage & Adjust Stock)
        end
    end

    Manager --> UC_Auth
    Manager --> UC_Users
    Manager --> UC_Cust
    Manager --> UC_Cat
    Manager --> UC_Allergens
    Manager --> UC_Prod
    Manager --> UC_Sizes
    Manager --> UC_Types
    Manager --> UC_Configs
    Manager --> UC_Predef
    Manager --> UC_Stock
    Manager --> UC_Catalog

    SystemUser --> UC_Auth
    
    Employee -.->|read-only| UC_Allergens
    Employee -.->|read-only| UC_Prod
    Employee -.->|read-only| UC_Configs
    Employee -.->|read-only| UC_Predef
    Employee --> UC_Stock
    Employee --> UC_Catalog
    
    Customer --> UC_Catalog