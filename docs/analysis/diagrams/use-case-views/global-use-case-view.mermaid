flowchart LR
    Manager([LaPrizza Manager])
    SystemUser([System User])
    Employee([Employee])
    Customer([Customer])
    Guest([Guest])
    Viz3D([3D Visualization Module])
    AI([AI Scheduling Module])
    InvitedUser([Invited User])
    IdP([External Identity Provider])
    Mail([E-mail Server])

    subgraph System [LaPrizza Information System]
        subgraph Auth [BCK01: Auth & Users]
            UC_Auth(Authenticate / Login)
            UC_Users(Manage Users)
        end
        subgraph Cust [BCK02: Customers]
            UC_Cust(Manage Customers)
        end
        subgraph Catalog [BCK03-05, 11: Catalogue & Products]
            UC_Cat(Manage Categories)
            UC_Allergens(Manage Allergens)
            UC_Prod(Manage Products)
            UC_Catalog(Consult Catalogue)
        end
        subgraph Config [BCK06-08, 10: Pizza Configuration]
            UC_Sizes(Manage Pizza Sizes)
            UC_Types(Manage Component Types)
            UC_Configs(Manage Component Configs)
            UC_Predef(Manage Predefined Pizzas)
        end
        subgraph Stock [BCK09: Stock]
            UC_Stock(Manage & Adjust Stock)
        end
        subgraph Navigation [WEB03: Role-Based Navigation]
            UC_Menu(Navigate with the Permitted Menu)
            UC_OpenPage(Open a Page by URL)
            UC_Reflect(Reflect Role and Status Changes)
        end
        subgraph Feedback [WEB04: User Feedback and Validation]
            UC_SubmitForm(Submit a Form)
            UC_ConfirmAction(Confirm a Significant Action)
            UC_Wait(Wait for Information)
            UC_Recover(Recover from a Failure)
        end
        subgraph Kitchen [WEB06: Kitchen Configuration]
            UC_Kitchen(Manage Kitchen Configurations)
            UC_ActiveKitchen(Get Active Kitchen Configuration)
        end
        subgraph KitchenLayout [VIS02: Kitchen Layout and Equipment]
            UC_Layout(View the Kitchen Layout)
        end
        subgraph Planning [WEB07: AI Planning]
            UC_Forecasts(Manage Forecasts)
            UC_Suppliers(Prepare Supplier Data)
            UC_Planning(Execute & Consult Planning)
        end
        subgraph Lighting [VIS05-06: 3D Scene Lighting]
            UC_Lit(View Lit Kitchen Scene)
            UC_AdjustLight(Adjust Scene Lighting)
        end
        subgraph BillOfMaterials [AI01: Bill of Materials]
            UC_Aggregates(Define Product Aggregates)
            UC_BOM(Calculate Bill of Materials)
        end
        subgraph RequirementsPlanning [AI02: Requirements Planning]
            UC_Requirements(Calculate Requirements Planning)
            UC_SelectSuppliers(Select Suppliers)
        end
        subgraph PlanningData [AI06: Planning Data]
            UC_Snapshot(Provide Planning Snapshot)
            UC_KB(Build Knowledge Base)
        end
        subgraph LocalAuth [AA01: Local Authentication]
            UC_LocalLogin(Log In with a Local Account)
            UC_EndSessions(End Sessions)
            UC_RecoverPwd(Recover Password)
            UC_ChangePwd(Change Password)
        end
        subgraph Authorization [AA05: Authorization Enforcement]
            UC_Authorize(Check Permissions on Every Request)
            UC_Permissions(Consult Own Permissions)
            UC_OwnData(Consult Own Customer Data)
        end
        subgraph Activation [AA07: Account Activation]
            UC_CheckLink(Check Activation Link)
            UC_Activate(Activate Local or External Account)
        end
    end

    Manager --> UC_Auth
    Manager --> UC_Users
    Manager --> UC_Cust
    Manager --> UC_Cat
    Manager --> UC_Allergens
    Manager --> UC_Prod
    Manager --> UC_Sizes
    Manager --> UC_Types
    Manager --> UC_Configs
    Manager --> UC_Predef
    Manager --> UC_Stock
    Manager --> UC_Catalog
    Manager --> UC_Kitchen
    Manager --> UC_ActiveKitchen
    Manager --> UC_Forecasts
    Manager --> UC_Suppliers
    Manager --> UC_Planning
    Manager --> UC_Aggregates
    Manager --> UC_BOM
    Manager --> UC_Requirements
    Manager --> UC_Layout
    Manager --> UC_Lit
    Manager --> UC_AdjustLight

    SystemUser --> UC_Auth
    SystemUser --> UC_LocalLogin
    SystemUser --> UC_EndSessions
    SystemUser --> UC_RecoverPwd
    SystemUser --> UC_ChangePwd
    SystemUser --> UC_SubmitForm
    SystemUser --> UC_ConfirmAction
    SystemUser --> UC_Wait
    SystemUser --> UC_Recover
    UC_SubmitForm -.->|include| UC_Recover

    Employee -.->|read-only| UC_Prod
    Employee -.->|read-only| UC_Configs
    Employee -.->|read-only| UC_Predef
    Employee -.->|read-only, active products| UC_Stock
    Employee --> UC_Catalog
    Employee --> UC_Layout

    Customer --> UC_Catalog
    Customer --> UC_OwnData

    Guest --> UC_Catalog
    Guest --> UC_Authorize
    Guest --> UC_Menu
    Guest --> UC_OpenPage
    SystemUser --> UC_Menu
    SystemUser --> UC_OpenPage
    SystemUser --> UC_Reflect
    UC_OpenPage -.->|checked by| UC_Authorize
    UC_Reflect -.->|uses| UC_Permissions
    SystemUser --> UC_Authorize
    SystemUser --> UC_Permissions
    UC_OwnData -.->|include| UC_Authorize

    Viz3D -->|consumes| UC_ActiveKitchen
    Viz3D -->|renders| UC_Layout
    UC_Layout -.->|uses| UC_ActiveKitchen
    Viz3D -->|renders| UC_Lit
    Viz3D -->|re-renders| UC_AdjustLight
    UC_BOM -->|executes| AI
    UC_BOM -.->|uses| UC_Snapshot
    UC_Requirements -->|executes| AI
    UC_Requirements -.->|include| UC_SelectSuppliers
    UC_Requirements -.->|uses| UC_Snapshot
    UC_Planning -->|executes| AI
    AI -->|pulls| UC_Snapshot
    AI --> UC_KB
    UC_Planning -.->|uses| UC_Snapshot

    InvitedUser --> UC_CheckLink
    InvitedUser --> UC_Activate
    UC_Activate -.->|include| UC_CheckLink
    UC_Activate -->|verifies identity at| IdP

    UC_RecoverPwd -->|sends link via| Mail
    UC_LocalLogin -.->|refines| UC_Auth
