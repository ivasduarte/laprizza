flowchart LR
    admin(["👤 System Administrator"])
    sched(["⏱ Deployment Scheduler"])
    gh(["GitHub repository"])
    api(["LaPrizza API service"])
    db(["MongoDB server"])
 
    subgraph SYS01["Staging VM – automated deployment"]
        UC1(("UC1 Deploy the latest<br/>version automatically"))
        UC2(("UC2 Deploy manually<br/>(branch / force)"))
        UC3(("UC3 Validate a<br/>release"))
        UC4(("UC4 Roll back<br/>automatically"))
        UC5(("UC5 Roll back to a<br/>previous version"))
        UC6(("UC6 Consult deployment<br/>status and logs"))
        UC7(("UC7 Configure or pause<br/>the schedule"))
    end
 
    sched --- UC1
    admin --- UC2
    admin --- UC5
    admin --- UC6
    admin --- UC7
    UC1 -. "«include»" .-> UC3
    UC2 -. "«include»" .-> UC3
    UC4 -. "«extend» (unhealthy release)" .-> UC1
    UC4 -. "«extend» (unhealthy release)" .-> UC2
    UC1 --- gh
    UC2 --- gh
    UC3 --- db
    UC3 --- api
    UC5 --- api
