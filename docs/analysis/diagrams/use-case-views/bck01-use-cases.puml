@startuml "bck01-use-case-view"
skinparam monochrome true
left to right direction

actor "System User" as user
actor "LaPrizza Manager" as manager

manager -|> user : "inherits        "

package "BCK01: User and Authentication Management" {
    usecase "UC1: Authenticate User (Login)" as uc1
    usecase "UC2: Register User" as uc2
    usecase "UC3: List Users" as uc3
    usecase "UC4: Get User" as uc4
    usecase "UC5: Update User" as uc5
}

user --> uc1
manager --> uc2
manager --> uc3
manager --> uc4
manager --> uc5
@enduml