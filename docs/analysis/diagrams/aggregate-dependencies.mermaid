flowchart TD
    subgraph users [Users]
        User
        Role
        ExternalIdentity
        AuthSession
        PasswordResetToken
    end
    subgraph customers [Customers]
        Customer
        Address
        DietaryRestriction
    end
    subgraph prod [Product]
        Product
        ProductCategory
        Allergen
        Aggregate
        AggregateItem
    end
    subgraph stock [Stock]
        StockInformation
    end
    subgraph pizza [Pizza]
        PizzaSize
        PizzaComponentType
        PredefinedPizza
        PizzaConfiguration
        ComponentSizeConfiguration
    end
    subgraph order [Order]
        Order
        OrderItem
    end
    subgraph kitchen [Kitchen]
        PreparationActivity
        KitchenResource
        KitchenConfiguration
        AssemblyLineConfiguration
    end
    subgraph forecasts [Forecasts]
        Forecast
        ForecastEntry
    end
    subgraph suppliers [Supplier Scenarios]
        SupplierScenario
        Supplier
        ScenarioProduct
        Offer
    end
    subgraph planning [Planning]
        PlanningRun
        PlanningRequest
        InputVersion
    end

    customers -->|via DietaryRestriction| prod
    prod -->|may maintain| stock
    prod -->|may be a component of| pizza
    pizza -->|represented by| prod
    order -->|placed by| customers
    order -->|catalogue product or configuration| prod
    order -->|may preserve a configuration| pizza
    order -->|may require resources| kitchen
    customers -.-> users
    forecasts -->|daily consumption of| prod
    forecasts -->|applicable size| pizza
    suppliers -->|offers for| prod
    planning -->|forecast version used| forecasts
    planning -->|supplier scenario version used| suppliers
    planning -->|requested by| users
