classDiagram
    namespace Users {
        class User {
            <<AggregateRoot>>
            +long id
            +String name
            +String username
            +String email
            +String passwordHash
            +String status
            +int tokenVersion
        }
        class Role {
            <<ValueObject>>
            +String name
        }
         class ExternalIdentity {
            <<ValueObject>>
            +String provider
            +String issuer
            +String subject
        }
        class AuthSession {
            <<AggregateRoot>>
            +long id
            +String refreshTokenHash
            +int tokenVersion
            +date createdAt
            +date lastUsedAt
            +date expiresAt
            +date revokedAt
        }
        class PasswordResetToken {
            <<AggregateRoot>>
            +long id
            +String tokenHash
            +date createdAt
            +date expiresAt
            +date usedAt
        }
    }
    namespace Customers {
        class Customer {
            <<AggregateRoot>>
            +long id
            +String name
            +String phoneNumber
            +String email
            +boolean marketingConsent
        }
        class Address {
            <<ValueObject>>
            +String street
            +String houseNumber
            +String complement
            +String postalCode
            +String city
            +String district
        }
        class DietaryRestriction {
            <<ValueObject>>
            +String description
        }
    }
    namespace Products {
        class Product {
            <<AggregateRoot>>
            +long id
            +String name
            +double price
            +String description
            +boolean active
            +boolean sellable
            +boolean stockControlled
            +isPizzaComponent() boolean
        }
        class Aggregate {
            <<ValueObject>>
            +String classification
        }
        class AggregateItem {
            <<ValueObject>>
            +int quantity
        }
        class ProductCategory {
            <<AggregateRoot>>
            +long id
            +String name
        }
        class Allergen {
            <<AggregateRoot>>
            +long id
            +String name
        }
    }
    namespace Stock {
        class StockInformation {
            <<Entity>>
            +int quantity
            +increase() int
            +decrease() int
        }
    }
    namespace Pizza {
        class PizzaSize {
            <<AggregateRoot>>
            +long id
            +String name
        }
        class PizzaComponentType {
            <<AggregateRoot>>
            +long id
            +String name
            +int assemblyOrder
            +int minQuantity
            +int maxQuantity
        }
        class ComponentSizeConfiguration {
            <<ValueObject>>
            +double price
            +int stockUnitsConsumed
        }
        class PizzaConfiguration {
            <<ValueObject>>
            +validate()
        }
        class PredefinedPizza {
            <<AggregateRoot>>
            +validate()
        }
    }
    namespace Orders {
        class Order {
            <<AggregateRoot>>
            +long id
            +String state
            +date createdAt
        }
        class OrderItem {
            <<Entity>>
            +int quantity
            +double unitPrice
            +String state
        }
    }
    namespace Kitchen {
        class KitchenResource {
            <<AggregateRoot>>
            +long id
            +String name
            +String type
            +int capacity
            +boolean available
        }
        class PreparationActivity {
            <<Entity>>
            +String name
            +int expectedDurationMinutes
            +String resourceType
            +String state
        }
        class KitchenConfiguration {
            <<AggregateRoot>>
            +long id
            +String name
            +boolean isActive
        }
        class AssemblyLineConfiguration {
            <<AggregateRoot>>
            +long id
            +String name
        }
    }
    namespace Forecasts {
        class Forecast {
            <<AggregateRoot>>
            +long id
            +String name
            +int version
            +date startDate
            +date endDate
            +boolean isActive
        }
        class ForecastEntry {
            <<ValueObject>>
            +date date
            +int quantity
        }
    }
    namespace SupplierScenarios {
        class SupplierScenario {
            <<AggregateRoot>>
            +long id
            +String name
            +int version
            +boolean simulated
            +boolean isActive
        }
        class Supplier {
            <<Entity>>
            +String id
            +String name
        }
        class ScenarioProduct {
            <<Entity>>
        }
        class Offer {
            <<ValueObject>>
            +double priceEur
            +int stockUnits
            +double leadTimeDays
            +int supplyLimit
        }
    }
    namespace Planning {
        class PlanningRun {
            <<AggregateRoot>>
            +long id
            +String kind
            +String snapshotId
            +String bomVersion
            +String status
            +date createdAt
        }
        class PlanningRequest {
            <<ValueObject>>
            +String scenarioId
            +String stockMode
        }
        class InputVersion {
            <<ValueObject>>
            +String id
            +String name
            +int version
        }
    }

    User "1..*" *-- "*" Role : has
    User "1" *-- "0..*" ExternalIdentity : signs in with
    Customer "0..1" -- "0..1" User : can be
    Customer "1" *-- "0..*" Address
    Customer "1" *-- "0..*" DietaryRestriction : records
    DietaryRestriction "*" -- "0..*" Allergen : may relate to
    Product "*" -- "1" ProductCategory : classified by
    Product "*" -- "0..*" Allergen : may contain
    Product "*" -- "0..1" PizzaComponentType : component role
    Product "1" -- "0..1" StockInformation : may maintain
    ComponentSizeConfiguration "*" -- "1" Product : component
    ComponentSizeConfiguration "*" -- "1" PizzaSize : for
    PizzaConfiguration "*" -- "1" PizzaSize : has
    PizzaConfiguration "*" -- "1..*" Product : composed of
    PredefinedPizza "1" -- "1" Product : represented by
    PredefinedPizza "1" *-- "*" PizzaConfiguration : defaultConfiguration
    PredefinedPizza "1" -- "1..*" PizzaSize : avalaible in
    PizzaConfiguration "*" .. "0..1" PredefinedPizza : originatedFrom
    Customer "0..1" -- "0..*" Order : places
    Order "1" *-- "1..*" OrderItem : contains
    OrderItem "*" -- "0..1" Product : catalogue product
    OrderItem "1" *-- "0..1" PizzaConfiguration : preserved configuration
    OrderItem "1" -- "0..*" PreparationActivity : may require
    PreparationActivity "*" -- "*" PreparationActivity : dependsOn
    PreparationActivity "*" -- "*" KitchenResource : uses
    AuthSession "*" -- "1" User : belongs to
    PasswordResetToken "*" -- "1" User : resets password of
    Product "1" *-- "0..1" Aggregate : is an aggregate
    Aggregate "1" *-- "0..*" AggregateItem : composed of
    AggregateItem "*" -- "1" Product : item
    KitchenConfiguration "*" -- "0..1" AssemblyLineConfiguration : places line
    Forecast "1" *-- "1..*" ForecastEntry : entries
    ForecastEntry "*" -- "1" Product : product
    ForecastEntry "*" -- "0..1" PizzaSize : size
    SupplierScenario "1" *-- "0..*" Supplier : suppliers
    SupplierScenario "1" *-- "0..*" ScenarioProduct : products
    ScenarioProduct "*" -- "1" Product : product
    ScenarioProduct "1" *-- "0..*" Offer : offers
    Offer "*" -- "1" Supplier : sold by
    PlanningRun "1" *-- "1" PlanningRequest : request
    PlanningRun "1" *-- "0..2" InputVersion : forecast, supplierScenario
    PlanningRun "*" .. "0..1" Forecast : used
    PlanningRun "*" .. "0..1" SupplierScenario : used
    PlanningRun "*" -- "0..1" User : requested by
