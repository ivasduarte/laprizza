C4Dynamic
    title Dynamic View - AI Requirements Planning Execution (Sprint 2)
    
    Person(manager, "LaPrizza Manager", "Initiates the planning scenario.")
    Container(spa, "Web Application", "React", "AI Configuration Page.")
    Container(backend, "Back-End Application", "Node.js", "Coordinates data and AI integration.")
    Container(ai, "AI Module", "Prolog", "Calculates materials and requirements.")
    ContainerDb(db, "Database", "MongoDB", "Stores forecasts and stock.")

    Rel(manager, spa, "1. Submits forecast execution request")
    Rel(spa, backend, "2. POST /api/v1/planning/execute")
    Rel(backend, db, "3. Retrieves active forecast, BOM, and stock snapshot")
    Rel(db, backend, "4. Returns required business data")
    Rel(backend, ai, "5. POST /requirements (JSON payload)")
    Rel(ai, ai, "6. Executes Prolog rules to calculate planning")
    Rel(ai, backend, "7. Returns calculated requirements and supplier selection")
    Rel(backend, db, "8. Saves simulation results (no operational stock changes)")
    Rel(backend, spa, "9. Returns 200 OK with planning results")
    Rel(spa, manager, "10. Displays daily planning breakdown and warnings")