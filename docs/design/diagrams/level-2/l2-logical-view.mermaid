C4Container
    title Level 2 Logical View - Containers
    
    Person(user, "System User", "Customer, Employee, or Manager.")
    
    System_Boundary(laprizza, "LaPrizza Information System") {
        Container(webApp, "Web Application", "React, Vite", "Provides the main SPA user interface for all roles.")
        Container(viz3d, "3D Visualization", "WebGL, Three.js", "Interactive 3D pizza configuration and kitchen layout viewer embedded in the SPA.")
        Container(backend, "Back-End Application", "Node.js, Express", "Provides REST APIs, business logic, RBAC, and data orchestration.")
        Container(ai, "AI Scheduling Module", "SWI-Prolog", "Calculates Bill of Materials (BOM) and executes Requirements Planning.")
        ContainerDb(db, "Database", "MongoDB", "Persists products, users, stock, configurations, and orders.")
    }
    
    Rel(user, webApp, "Interacts with", "HTTPS")
    Rel(webApp, viz3d, "Embeds", "Browser/DOM")
    Rel(webApp, backend, "Makes API calls to", "JSON/HTTPS")
    Rel(viz3d, backend, "Fetches 3D layouts and assets from", "JSON/HTTPS")
    Rel(backend, ai, "Requests planning algorithms from", "JSON/HTTPS")
    Rel(backend, db, "Reads from and writes to", "Mongoose/TCP")