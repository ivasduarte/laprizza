flowchart TD
    title[Level 2 Development View - Layered Architecture]
    
    api[Presentation Layer<br/>api]
    application[Application Layer<br/>application]
    domain[Domain Layer<br/>domain]
    infrastructure[Infrastructure Layer<br/>infrastructure]

    %% Dependencies go inwards (Outer layers depend on inner layers)
    api -.->|uses| application
    application -.->|uses| domain
    infrastructure -.->|uses| domain