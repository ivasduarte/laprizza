@startuml "logical-view"
!include <C4/C4_Container>

title "Level 2 Logical View"

Person(user, "User", "Customer or Staff")

System_Boundary(laprizza, "LaPrizza Information System") {
    Container(webApp, "Web Application", "TBD", "Provides the main user interface.")
    Container(viz3d, "3D Visualization", "WebGL, Three.js", "Interactive 3D pizza configuration and kitchen view.")
    Container(ai, "AI Scheduling", "Prolog", "Schedules food preparation activities.")
    Container(backend, "Back-End Application", "Node.js, Express", "Provides REST APIs, business logic, and security.")
    ContainerDb(db, "Database", "MongoDB", "Stores products, users, stock, and orders.")
}

Rel(user, webApp, "Interacts", "HTTPS")
Rel(webApp, viz3d, "Embeds", "Browser")
Rel(webApp, backend, "Calls APIs", "JSON/HTTPS")
Rel(viz3d, backend, "Calls APIs", "JSON/HTTPS")
Rel(ai, backend, "Fetches/Updates schedules", "JSON/HTTPS")
Rel(backend, db, "Reads/Writes", "Mongoose/TCP")

SHOW_LEGEND()
@enduml