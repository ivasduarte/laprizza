flowchart TD
    title[Level 3 Development View - Package Decomposition]
    
    subgraph Backend[Back-End Codebase src/]
        subgraph api[api]
            Controllers
            Routes
            AuthMiddleware[Authorization Middleware]
        end
        subgraph app[application]
            UseCases[Service Use Cases]
            DTOs[Data Transfer Objects]
        end
        subgraph dom[domain]
            Entities
            ValueObjects[Value Objects]
            DomainServices[Domain Services]
            RepositoryInterfaces[Repository Interfaces]
        end
        subgraph infra[infrastructure]
            Mongo[MongoDB Persistence]
            RepoImpl[Repository Implementations]
            Migrations[Migrations & Seed]
            Config[Environment & Secrets]
        end
    end

    api -.->|imports| app
    app -.->|imports| dom
    dom -.->|imports| dom
    infra -.->|imports| dom