@startuml "physical-view"
!include <C4/C4_Deployment>

title "Level 3 Physical View"

Deployment_Node(server, "Application Server", "Linux") {
    Deployment_Node(node, "Node.js Runtime", "Node.js v20+") {
        Container(backend, "Back-End Application", "Node.js, Express")
    }
}

Deployment_Node(dbserver, "Database Server", "Linux") {
    Deployment_Node(mongoEnv, "MongoDB Instance", "MongoDB") {
        ContainerDb(db, "Database", "MongoDB")
    }
}

Rel(backend, db, "Reads/Writes", "TCP")

SHOW_LEGEND()
@enduml