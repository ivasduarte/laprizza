C4Component
    title Level 3 Logical View - Back-End Application Components
    
    Container(webApp, "Web Application", "React", "Consumes REST APIs.")
    Container(ai, "AI Module", "Prolog", "Provides planning capabilities.")
    ContainerDb(db, "Database", "MongoDB", "Persists data.")

    Container_Boundary(backend, "Back-End Application") {
        Component(api, "API Router & Middleware", "Express Router", "Handles HTTP routing, JWT verification, Joi validation, and RBAC.")
        
        Component(auth, "Auth Module", "Service & Controller", "Handles local/external login and account management.")
        Component(users, "Users & Customers Module", "Service & Controller", "Manages roles and customer profiles.")
        Component(products, "Products Module", "Service & Controller", "Manages products, categories, allergens, and catalogue.")
        Component(pizza, "Pizza Config Module", "Service & Controller", "Manages pizza sizes, component types, and predefined pizzas.")
        Component(stock, "Stock Module", "Service & Controller", "Manages inventory quantities and adjustments.")
        
        Component(domain, "Domain Layer", "Entities & Value Objects", "Encapsulates pure business rules and domain validations.")
        Component(infra, "Infrastructure Repositories", "Mongoose / Dummy", "Implements persistence mapping and external service integrations.")
    }

    Rel(webApp, api, "Calls", "JSON/HTTPS")
    
    Rel(api, auth, "Routes to")
    Rel(api, users, "Routes to")
    Rel(api, products, "Routes to")
    Rel(api, pizza, "Routes to")
    Rel(api, stock, "Routes to")
    
    Rel(auth, domain, "Applies rules from")
    Rel(users, domain, "Applies rules from")
    Rel(products, domain, "Applies rules from")
    Rel(pizza, domain, "Applies rules from")
    Rel(stock, domain, "Applies rules from")

    Rel(auth, infra, "Uses")
    Rel(users, infra, "Uses")
    Rel(products, infra, "Uses")
    Rel(pizza, infra, "Uses")
    Rel(stock, infra, "Uses")
    
    Rel(infra, db, "Reads/Writes", "TCP")
    Rel(infra, ai, "Bridges calls to", "HTTPS")