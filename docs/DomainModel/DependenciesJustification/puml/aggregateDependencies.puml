@startuml

title LaPrizza - Aggregate Dependencies Graph

skinparam componentStyle rectangule
skinparam backgroundColor white

package "Users" as users {
    [User]
    [Role]
}

package "Customers" as customers {
    [Customer]
    [Address]
    [DietaryRestriction]
}

package "Product" as prod {
    [Product]
    [ProductCategory]
    [Allergen]
}

package "Stock" as stock {
    [StockInformation]
}

package "Pizza" as pizza {
    [PizzaSize]
    [PizzaComponentType]
    [PredefinedPizza]
    [PizzaConfiguration]
    [ComponentSizeConfiguration]
}

package "Order" as order {
    [Order]
    [OrderItem]
}

package "Kitchen" as kitchen {
    [PreparationActivity]
    [KitchenResource]
}

users <-down- customers

customers -right-> prod : via DietaryRestriction

prod -right-> stock : may maintain
prod -down-> pizza : may be a component of

pizza --> prod : represented by

order --up-> customers : placed by
order --up-> prod : catalogue product or configuration
order --> pizza : may preserve a configuration
order -down-> kitchen : may require resources

@enduml