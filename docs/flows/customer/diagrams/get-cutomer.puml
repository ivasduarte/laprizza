@startuml "UC3_Get_Customer_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route 
participant "CustomersController" as controller 
participant "CustomersService" as service 
participant "CustomersRepository\n(MongoDB/Dummy)" as repo 

activate Manager
Manager -> route : GET /customers/:id
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> route : Validate Object ID (Joi)
route -> controller : getById(req, res, next)
activate controller 

controller -> service : getCustomerById(id, repository)
activate service

service -> repo : findById(id)
activate repo
repo --> service : Customer Entity (or null)
deactivate repo

alt Customer Not Found
    service --> controller : AppError(404)
else Customer Found
    service -> service : toCustomerDto(Customer)
    service --> controller : Customer DTO
end
deactivate

controller --> Manager : Response (200 OK or Error)
deactivate controller
deactivate route
@enduml