@startuml "UC2_List_Search_Customers_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route
participant "CustomersController" as controller
participant "CustomersService" as service
participant "CustomersRepository\n(MongoDb/Dummy)" as repo

activate Manager
Manager -> route : GET /customers?search={term}
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> route : Validate Query (Joi)
route -> controller : list(req, res, next)
activate controller

controller -> service : listCustomers(query, repo)
activate service

service -> repo : listCustomers(query)
activate repo
repo --> service : Array<Customer Entity>
deactivate repo

service -> service : map(toCustomerDto)
service --> controller : Array<Customer DTO>
deactivate service

controller --> Manager : Response (200 OK or Error)
deactivate controller
deactivate route
@enduml