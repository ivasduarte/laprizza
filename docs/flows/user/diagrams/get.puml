@startuml "get"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route
participant "UsersController" as controller
participant "UsersService" as service
participant "UsersRepository\n(MongoDB/Dummy)" as repo

activate Manager
Manager -> route : GET /users/:id
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> route : Validate Object ID (Joi)
route -> controller : getById(req, res, next)
activate controller

controller -> service : getUserById(id, repo)
activate service

service -> repo : findById(id)
activate repo
repo --> service : User Entity (or null)
deactivate repo

alt User Not Found
    service --> controller : AppError(404)
else User Found
    service -> service : toUserDto(User)
    service --> controller : User DTO
end
deactivate service

controller --> Manager : Response (200 OK or Error)
deactivate controller
deactivate route
@enduml
