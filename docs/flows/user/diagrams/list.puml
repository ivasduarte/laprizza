@startuml "list"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route
participant "UsersController" as controller
participant "UsersService" as service
participant "UsersRepository\n(MongoDB/Dummy)" as repo

activate Manager
Manager -> route : GET /users
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> controller : list(req, res, next)
activate controller

controller -> service : listUsers(repo)
activate service

service -> repo : listUsers()
activate repo
repo --> service : Array<User Entity>
deactivate repo

service -> service : map(toUserDto)
service --> controller : Array<User DTO>
deactivate service

controller --> Manager : Response (200 OK)
deactivate controller
deactivate route
@enduml