@startuml "UC1_Create_Component_Size_Configuration_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route
participant "ComponentSizeConfigurationController" as controller
participant "ComponentSizeConfigurationService" as service
participant "ComponentSizeConfigurationDomain" as domain
participant "ProductsRepository\n(MongoDb/Dummy)" as productsRepo
participant "PizzaSizeRepository\n(MongoDb/Dummy)" as sizeRepo

activate Manager
Manager -> route : POST /products/{productId}/size-configurations\n{ pizzaSizeId, price, stockUnitsConsumed }
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> route : Validate Ids & Payload (Joi)
route -> controller : create(req, res, next)
activate controller

controller -> service : createComponentSizeConfiguration(productId, data, repositories)
activate service

service -> domain : normalizeStockUnitsConsumed(stockUnitsConsumed)\n& validatePizzaSizeId(pizzaSizeId) & validatePrice(price)
activate domain
domain --> service : valid

service -> productsRepo : findById(productId)
activate productsRepo
productsRepo --> service : Product Entity (active)
deactivate productsRepo

service -> domain : validateProductIsPizzaComponent(product)
domain --> service : valid

service -> sizeRepo : findById(pizzaSizeId)
activate sizeRepo
sizeRepo --> service : PizzaSize Entity (active)
deactivate sizeRepo

service -> domain : validateStockUnitsConsumed(product.stockControlled, stockUnitsConsumed)\n& findSizeConfiguration(product, pizzaSizeId)
domain --> service : valid, size not configured yet
deactivate domain

service -> productsRepo : addSizeConfiguration(productId, configuration)
activate productsRepo
productsRepo --> service : Updated Product Entity
deactivate productsRepo

service -> service : toComponentSizeConfigurationDTO(productId, configuration)
service --> controller : ComponentSizeConfiguration DTO
deactivate service

controller --> Manager : Response (201 Created)
deactivate controller
deactivate route
@enduml