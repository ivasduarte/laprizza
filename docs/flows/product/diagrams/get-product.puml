@startuml "UC3_Get_Product_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor "Manager / Employee" as user
participant "Route (Joi & RBAC)" as route
participant "ProductsController" as controller
participant "ProductsService" as service
participant "ProductsRepository\n(MongoDB/Dummy)" as repo

activate user
user -> route : GET /products/:id
activate route
route -> route : verifyToken() & requireRole([MANAGER, EMPLOYEE])
route -> route : Validate Object ID (Joi)
route -> controller : getById(req, res, next)
activate controller

controller -> service : getProductById(id, repos)
activate service

service -> repo : findById(id)
activate repo
repo --> service : Product Entity (or null)
deactivate repo

alt Product Not Found
    service --> controller : AppError(404)
else Product Found
    service -> service : toProductDTO(Product)
    service --> controller : Product DTO
end

deactivate service
controller --> user : Response (200 OK or Error)
deactivate controller
deactivate route
@enduml