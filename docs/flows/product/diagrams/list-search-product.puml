@startuml "UC2_List_Search_Products_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor "Manager / Employee" as user
participant "Route (Joi & RBAC)" as route
participant "ProductsController" as controller
participant "ProductsService" as service
participant "ProductsRepository\n(MongoDb/Dummy)" as repo

activate user
user -> route : GET /products?search={term}&categoryId={id}...
activate route
route -> route : verifyToken() & requireRole([MANAGER, EMPLOYEE])
route -> route : Validate Query (Joi)
route -> controller : list(req, res, next)
activate controller

controller -> service : listProducts(query, repos)
activate service

service -> repo : listProducts(query)
activate repo
repo --> service : Array<Product Entity>
deactivate repo

service -> service : map(toProductDTO)
service --> controller : Array<Product DTO>

deactivate service
controller --> user : Response (200 OK or Error)
deactivate controller
deactivate route
@enduml