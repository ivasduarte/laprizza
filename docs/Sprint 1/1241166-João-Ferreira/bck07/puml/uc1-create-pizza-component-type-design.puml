@startuml "UC1_Create_Pizza_Component_Type_Design"
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor Manager
participant "Route (Joi & RBAC)" as route
participant "PizzaComponentTypeController" as controller
participant "PizzaComponentTypeService" as service
participant "PizzaComponentTypeDomain" as domain
participant "PizzaComponentTypeRepository\n(MongoDb/Dummy)" as repo

activate Manager
Manager -> route : POST /pizza-component-type { name, assemblyOrder, minQuantity, maxQuantity }
activate route
route -> route : verifyToken() & requireRole([MANAGER])
route -> route : Validate Payload (Joi)
route -> controller : create(req, res, next)
activate controller

controller -> service : createPizzaComponentType(data, repo)
activate service

service -> domain : normalizeName(name) & normalizeMaxQuantity(maxQuantity)
activate domain
domain --> service : normalizedName, normalizedMaxQuantity

service -> domain : validateName, validateAssemblyOrder, validateMinQuantity,\nvalidateMaxQuantity & validateQuantityRange
domain --> service : valid
deactivate domain

service -> repo : create(typeData)
activate repo
repo --> service : PizzaComponentType Entity
deactivate repo

service -> service : toPizzaComponentTypeDTO(PizzaComponentType)
service --> controller : PizzaComponentType DTO
deactivate service

controller --> Manager : Response (201 Created)
deactivate controller
deactivate route
@enduml