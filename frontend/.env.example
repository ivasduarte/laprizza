# Dev server port and origin (must match the backend CORS allowed origin)
VITE_PORT=4200
VITE_ORIGIN=http://localhost:4200

# Backend API base URL. Use the current version (v2): the refresh cookie of the external login
# is scoped to /api/v2/auth.
VITE_API_BASE_URL=http://localhost:3000/api/v2

VITE_HTTP_TIMEOUT_MS=16000
VITE_HTTP_MUTATION_TIMEOUT_MS=35000