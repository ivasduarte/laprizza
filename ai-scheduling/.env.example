# Back end usado pelo serviço Prolog. Por omissão, o back end local.
# Para usar a VM de staging (VPN ligada):
# AI_BACKEND_URL=http://10.9.22.22/api/v1
AI_BACKEND_URL=http://127.0.0.1:3000/api/v1
AI_PORT=5000
AI_BACKEND_TIMEOUT_SECONDS=10
# AI05: chave partilhada com o back end (o mesmo valor em AI_SERVICE_KEY do back end).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_KEY=
