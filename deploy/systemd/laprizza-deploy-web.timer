[Unit]
Description=LaPrizza – agendamento do deploy automático do front end

[Timer]
# De 30 em 30 minutos, desfasado (minutos 15 e 45) do deploy do back end (minutos 00 e 30)
# Para alterar sem mexer neste ficheiro:  sudo systemctl edit laprizza-deploy-web.timer
#   [Timer]
#   OnCalendar=
#   OnCalendar=Mon..Fri 08..20:15
OnCalendar=*:15,45
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
