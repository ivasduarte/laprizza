[Unit]
Description=LaPrizza – agendamento do deploy automático do back end

[Timer]
# Agendamento (hora local da VM, Europe/Lisbon). Por omissão: de 30 em 30 minutos.
# Para alterar sem mexer neste ficheiro:  sudo systemctl edit laprizza-deploy.timer
#   [Timer]
#   OnCalendar=
#   OnCalendar=Mon..Fri 08..20:00
OnCalendar=*:0/30
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target