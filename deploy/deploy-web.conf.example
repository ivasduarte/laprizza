# Configuração do deploy automático do front end
# Copiar para /opt/laprizza/deploy-web.conf (dono: deploy, chmod 640).
# Este ficheiro NÃO tem segredos.

# Branch publicado. A forma ${VAR:-valor} permite sobrepor na linha de comandos:
#   DEPLOY_BRANCH=feat/xyz /opt/laprizza/bin/laprizza-deploy-web.sh deploy
DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"

# Pasta do front end dentro do repositório e pasta que o build produz
WEB_SUBDIR=frontend
BUILD_OUTPUT=dist

# Quantas versões manter em /var/www/laprizza/releases (inclui a atual e a anterior)
KEEP_RELEASES=5

# Validação antes de publicar (pôr false se o script não existir no package.json do frontend)
RUN_LINT=true
RUN_TESTS=true

# Variáveis de ambiente usadas no build. O Vite só expõe as que começam por VITE_.
# O nginx reencaminha /api/ para o back end, por isso o front end usa um caminho
# relativo e não precisa de saber o endereço público da VM.
# O frontend lê VITE_API_BASE_URL (frontend/src/health.js).
# v2 é a versão atual: o cookie de refresh do login externo tem o caminho /api/v2/auth, por isso
# o SPA tem de chamar a mesma versão (com /api/v1 o F5 depois de um login externo termina a sessão).
WEB_BUILD_ENV=("VITE_API_BASE_URL=/api/v2")

# Se o build contiver este texto, o deploy aborta. Está desativado porque o
# health.js tem http://localhost:3000/api/v1 como valor por omissão, que fica
# sempre dentro do bundle (mesmo com a variável definida).
BUILD_MUST_NOT_CONTAIN=""

# Verificação depois de trocar a versão (nginx local)
# HTTPS (o nginx redireciona a porta 80). Ver HEALTH_CURL_TLS_OPTS no script.
SITE_URL=https://localhost/
VERSION_URL=https://localhost/version.json
HEALTH_TIMEOUT_SECONDS=30
