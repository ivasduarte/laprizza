# /opt/laprizza/.env  (PRODUÇÃO)  dono: deploy, chmod 600. NUNCA no repositório.
# Gerar cada segredo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Todos os segredos são DIFERENTES dos do staging.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# MongoDB: o mesmo servidor do staging (10.9.22.16, rede interna do DEI; a vs944 não tem AVX),
# mas numa database própria e com um utilizador que só tem dbOwner nela. Nunca "laprizza" (staging).
MONGODB_URI=mongodb://laprizza_prod_app:<password>@10.9.22.16:27017/laprizza_prod?authSource=admin
MONGODB_DB_NAME=laprizza_prod

JWT_SECRET=<gerar>
SEED_MANAGER_PASSWORD=<password forte, só para o primeiro arranque>
AI_SERVICE_URL=http://127.0.0.1:5000
AI_SERVICE_KEY=<gerar; o mesmo valor no .env do serviço Prolog>

# Endereço público (VM vs944): o vs-gate termina o HTTPS na porta 10944
APP_BASE_URL=https://vs-gate.dei.isep.ipp.pt:10944
CORS_ORIGIN=https://vs-gate.dei.isep.ipp.pt:10944
API_PUBLIC_URL=https://vs-gate.dei.isep.ipp.pt:10944

# Proxies à frente do back end: vs-gate e nginx. Só usar 2 depois de confirmar que o vs-gate
# envia X-Forwarded-For (ver "Client IP" em docs/sys-admin/production-environment.md);
# caso contrário 1 (todos os clientes aparecem com o IP do vs-gate).
TRUST_PROXY=1

# Sessões (AA04): o browser usa HTTPS, por isso o cookie de refresh pode e deve ser Secure.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict

RATE_LIMIT_ENABLED=true

# Convites e recuperação de password: SMTP real (o Mailpit é só para desenvolvimento)
SMTP_HOST=<servidor SMTP>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<utilizador>
SMTP_PASSWORD=<password>
# Entre aspas: o .env também é lido pelo bash (migrations), e < > seriam redirecionamentos.
MAIL_FROM="LaPrizza <no-reply@laprizza.pt>"
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

SHARED_DIR=/srv/laprizza-shared

# Login externo (AA02): possível em produção (HTTPS e domínio público). Registar no fornecedor:
#   https://vs-gate.dei.isep.ipp.pt:10944/api/v2/auth/external/<google|microsoft>/callback
# Sem estas variáveis, os botões não aparecem.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
