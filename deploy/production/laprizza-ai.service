[Unit]
Description=LaPrizza – serviço de planeamento (Prolog, AI01/AI05)
After=network-online.target laprizza-api.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/laprizza/ai-scheduling
ExecStart=/opt/laprizza/ai-scheduling/start-server.sh
Restart=on-failure
RestartSec=5
# Sem PrivateTmp/ProtectSystem: as VMs do DEI não permitem mount namespaces (ver laprizza-api.service).
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
